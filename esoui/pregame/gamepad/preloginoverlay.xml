<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_PreloginOverlayTopLevel" hidden="true" layer="BACKGROUND" level="1" tier="LOW">
            <AnchorFill />

            <OnInitialized>
                ZO_PreloginOverlay.InitializeControl(self)
            </OnInitialized>

            <OnUpdate>
                self.owner:OnUpdate()
            </OnUpdate>

            <Controls>
                <Texture name="$(parent)Backdrop" level="1" color="000000">
                    <AnchorFill />
                </Texture>

                <Control name="$(parent)Spinner">
                    <Anchor point="BOTTOM" offsetY="-50" />

                    <Controls>
                        <Texture name="$(parent)Ouroboros" level="3" pixelRoundingEnabled="false" textureFile="EsoUI/Art/PregameAnimatedBackground/ouroboros_loading.dds" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
                            <Anchor point="BOTTOM" />

                            <OnInitialized>
                                local HAS_STATIC_ANCHORS = true
                                ZO_PreloginOverlay_RegisterTextureControl(self, HAS_STATIC_ANCHORS)
                            </OnInitialized>
                        </Texture>

                        <Texture name="$(parent)OuroborosBloom" blendMode="ADD" level="4" pixelRoundingEnabled="false" textureFile="EsoUI/Art/PregameAnimatedBackground/ouroboros_loading_bloom.dds" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
                            <Anchor point="BOTTOM" />

                            <OnInitialized>
                                local HAS_STATIC_ANCHORS = true
                                ZO_PreloginOverlay_RegisterTextureControl(self, HAS_STATIC_ANCHORS)
                            </OnInitialized>
                        </Texture>

                        <Texture name="$(parent)OuroborosLight" blendMode="ADD" level="5" pixelRoundingEnabled="false" textureFile="EsoUI/Art/PregameAnimatedBackground/ouroboros_loading_light.dds" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
                            <Anchor point="BOTTOM" />

                            <OnInitialized>
                                local HAS_STATIC_ANCHORS = true
                                ZO_PreloginOverlay_RegisterTextureControl(self, HAS_STATIC_ANCHORS)
                            </OnInitialized>
                        </Texture>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>