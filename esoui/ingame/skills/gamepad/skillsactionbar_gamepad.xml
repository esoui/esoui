<GuiXml>
    <Controls>
        <Control name="ZO_SkillsActionButton_Gamepad" inherits="ZO_GamepadSkillsActionButton" virtual="true" tier="MEDIUM">
            <OnInitialized>
                self.abilityIcon = self:GetNamedChild("Icon")
                self.lockIcon = self:GetNamedChild("Lock")
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)Lock" override="true" hidden="true"/>
            </Controls>
        </Control>
        <Control name="ZO_SkillsActionBar_Gamepad_Control" inherits="ZO_SkillsActionBar_Control" virtual="true">
            <Dimensions x="466" y="106"/>
            <OnInitialized>
                ZO_SkillsActionBar_Gamepad:New(self, ZO_SkillsActionBarSlot_Gamepad)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Button1" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="BOTTOMLEFT" offsetX="54" offsetY="-14"/>
                </Control>
                <Control name="$(parent)Button2" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="LEFT" relativeTo="$(parent)Button1" relativePoint="RIGHT" offsetX="19"/>
                </Control>
                <Control name="$(parent)Button3" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="LEFT" relativeTo="$(parent)Button2" relativePoint="RIGHT" offsetX="19"/>
                </Control>
                <Control name="$(parent)Button4" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="LEFT" relativeTo="$(parent)Button3" relativePoint="RIGHT" offsetX="19"/>
                </Control>
                <Control name="$(parent)Button5" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="LEFT" relativeTo="$(parent)Button4" relativePoint="RIGHT" offsetX="19"/>
                </Control>
                <Control name="$(parent)UltimateButton" inherits="ZO_SkillsActionButton_Gamepad">
                    <Anchor point="LEFT" relativeTo="$(parent)Button5" relativePoint="RIGHT" offsetX="38"/>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
