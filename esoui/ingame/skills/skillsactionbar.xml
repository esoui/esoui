<GuiXml>
    <Controls>
        <Control name="ZO_SkillsActionButton" virtual="true">
            <OnInitialized>
                self.abilityIcon = self:GetNamedChild("Icon")
                self.lockIcon = self:GetNamedChild("Lock")
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)Icon" hidden="true"/>
                <Texture name="$(parent)Lock" hidden="true"/>
            </Controls>
        </Control>
        <Control name="ZO_SkillsActionBar_Control" virtual="true">
            <OnInitialized>
                ZO_SkillsActionBar:New(self, ZO_SkillsActionBarSlot)
            </OnInitialized>
        </Control>
    </Controls>
</GuiXml>
