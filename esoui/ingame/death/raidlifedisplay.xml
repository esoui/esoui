<GuiXml>
    <Animations>
        <AnimationTimeline name="ZO_RaidLifeChangeAnimation">
            <Animations>
                <AlphaAnimation duration="250" startAlpha="0.1" endAlpha="1">
                    <EasingFunction>
                        return ZO_EaseInCubic(progress)
                    </EasingFunction>
                </AlphaAnimation>
                <ScaleAnimation duration="250" startScale="3" endScale="1">
                    <EasingFunction>
                        return ZO_EaseInOutCubic(progress)
                    </EasingFunction>
                </ScaleAnimation>
            </Animations>
        </AnimationTimeline>
        <AnimationTimeline name="ZO_RaidLifeAlphaAnimation">
            <Animations>
                <AlphaAnimation duration="250" startAlpha="0" endAlpha="1">
                    <OnPlay>
                        animatingControl:SetHidden(false)
                    </OnPlay>
                    <OnStop>
                        if(self:GetTimeline():IsPlayingBackward()) then
                            animatingControl:SetHidden(true)
                        end
                    </OnStop>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <Control name="ZO_RaidLifeDisplay_Keyboard_Template" virtual="true">
            <Anchor point="BOTTOMRIGHT"/>
            <Controls>
                <Label name="$(parent)TrialProgressionLabel" font="ZoFontGameLargeBold" modifyTextType="NONE">
                    <Anchor point="LEFT" offsetY="2"/>
                </Label>
                <Label name="$(parent)TrialProgressionPoints" font="ZoFontWinH2">
                    <Anchor point="LEFT" relativeTo="$(parent)TrialProgressionLabel" relativePoint="RIGHT" offsetX="5" offsetY="-2"/>
                </Label>
                <Label name="$(parent)ScoreLabel" font="ZoFontGameLargeBold" modifyTextType="NONE" text="SI_REVIVE_COUNTER_SCORE">
                    <Anchor point="LEFT" relativeTo="$(parent)TrialProgressionPoints" relativePoint="RIGHT" offsetX="20" offsetY="2"/>
                </Label>
                <Label name="$(parent)TotalScore" font="ZoFontWinH2">
                    <Anchor point="LEFT" relativeTo="$(parent)ScoreLabel" relativePoint="RIGHT" offsetX="5" offsetY="-2"/>
                </Label>
                <Texture name="$(parent)Icon">
                    <Anchor point="LEFT" relativeTo="$(parent)TotalScore" relativePoint="RIGHT" offsetX="20"/>
                </Texture>
                <Label name="$(parent)ReviveCounter" font="ZoFontWinH2"/>
            </Controls>
        </Control>
        <Control name="ZO_RaidLifeDisplay_Gamepad_Template" virtual="true">
            <Anchor point="BOTTOMLEFT"/>
            <Controls>
                <Texture name="$(parent)Icon">
                    <Anchor point="LEFT"/>
                </Texture>
                <Label name="$(parent)ReviveCounter" font="ZoFontGamepad42"/>
                <Label name="$(parent)ScoreLabel" font="ZoFontGamepad27" modifyTextType="UPPERCASE" text="SI_REVIVE_COUNTER_SCORE">
                    <Anchor point="LEFT" relativeTo="$(parent)ReviveCounter" relativePoint="RIGHT" offsetX="20" offsetY="5"/>
                </Label>
                <Label name="$(parent)TotalScore" font="ZoFontGamepad42">
                    <Anchor point="LEFT" relativeTo="$(parent)ScoreLabel" relativePoint="RIGHT" offsetX="10" offsetY="-5"/>
                </Label>
                <Label name="$(parent)TrialProgressionLabel" font="ZoFontGamepad27" modifyTextType="UPPERCASE">
                    <Anchor point="LEFT" relativeTo="$(parent)TotalScore" relativePoint="RIGHT" offsetX="20" offsetY="5"/>
                </Label>
                <Label name="$(parent)TrialProgressionPoints" font="ZoFontGamepad42">
                    <Anchor point="LEFT" relativeTo="$(parent)TrialProgressionLabel" relativePoint="RIGHT" offsetX="10" offsetY="-5"/>
                </Label>
            </Controls>
        </Control>
        <Control name="ZO_RaidLifeDisplay" inherits="ZO_HUDManager_Element" resizeToFitDescendents="true" virtual="true">
            <OnInitialized>
                ZO_RaidLifeDisplay_OnInitialized(self)
            </OnInitialized>
            <OnEffectivelyShown>
                ZO_RaidLifeDisplay_OnEffectivelyShown(self)
            </OnEffectivelyShown>
            <Controls>
                <Texture name="$(parent)Icon" textureFile="EsoUI/Art/Trials/VitalityDepletion.dds">
                    <Dimensions x="40" y="40"/>
                </Texture>
                <Label name="$(parent)ReviveCounter">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="5"/>
                </Label>
                <Label name="$(parent)TotalScore"/>
                <Label name="$(parent)ScoreLabel" text="SI_REVIVE_COUNTER_SCORE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"/>
                <Label name="$(parent)TrialProgressionPoints"/>
                <Label name="$(parent)TrialProgressionLabel" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"/>
                <Control name="$(parent)HUDElementRef" override="true">
                    <DimensionConstraints minX="100"/>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
