<GuiXml>
    <Controls>
        <Control name="ZO_ZoneStory_ActivityCompletionHeader_Keyboard" virtual="true">
            <Controls>
                <Label name="$(parent)Text" font="ZoFontWinH2" modifyTextType="UPPERCASE">
                    <Anchor point="TOPLEFT"/>
                </Label>
            </Controls>
        </Control>
        <Control name="ZO_ZoneStory_ActivityCompletionTile_Keyboard_Control" inherits="ZO_NoOverlayContextualActionsTile_Control ZO_NoOverlayContextualActionsTile_Keyboard_Control" mouseEnabled="true" virtual="true">
            <Dimensions x="ZO_ZONE_STORIES_ACTIVITY_COMPLETION_TILE_KEYBOARD_DIMENSIONS_X" y="ZO_ZONE_STORIES_ACTIVITY_COMPLETION_TILE_KEYBOARD_DIMENSIONS_Y"/>
            <OnInitialized>
                ZO_ZoneStory_ActivityCompletionTile_Keyboard.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Backdrop name="$(parent)SelectionFrame" inherits="ZO_SelectionFrameBackdrop" edgeColor="76BCC3" layer="BACKGROUND" level="2" hidden="true">
                    <Anchor point="TOPLEFT" offsetX="0" offsetY="0"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="0" offsetY="0"/>
                </Backdrop>
                <Texture name="$(parent)Icon" override="true">
                    <Dimensions x="ZO_ZONE_STORIES_ACTIVITY_COMPLETION_TILE_KEYBOARD_ICON_DIMENSIONS" y="ZO_ZONE_STORIES_ACTIVITY_COMPLETION_TILE_KEYBOARD_ICON_DIMENSIONS"/>
                    <Anchor point="LEFT" offsetX="4"/>
                </Texture>
                <Label name="$(parent)Title" override="true" font="ZoFontWinH4">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT"/>
                    <Anchor point="RIGHT" constrains="X"/>
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
