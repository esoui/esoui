<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_TamrielTomes_SharedTL" hidden="true" resizeToFitDescendents="true" virtual="true" mouseEnabled="true">
            <Controls>
                <Texture name="$(parent)PageBackground" textureFile="EsoUI/Art/TamrielTomes/tome_page.dds" level="1" excludeFromResizeToFitExtents="true">
                    <Dimensions x="982"/>
                </Texture>
                <Texture name="$(parent)BookEdge" textureFile="EsoUI/Art/TamrielTomes/tome_cover_edge.dds" level="2" excludeFromResizeToFitExtents="true">
                    <Dimensions x="38"/>
                </Texture>
                <Texture name="$(parent)BookEdgeDamage" textureFile="EsoUI/Art/TamrielTomes/tome_cover_edge_damage.dds" level="3" excludeFromResizeToFitExtents="true">
                    <Dimensions x="38"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)BookEdge"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)BookEdge"/>
                </Texture>
                <Control name="$(parent)Header" resizeToFitDescendents="true">
                    <Dimensions x="860"/>
                    <Anchor point="TOP" offsetY="20"/>
                    <ResizeToFitPadding height="10"/>
                    <Controls>
                        <Label name="$(parent)Title" horizontalAlignment="CENTER">
                            <Anchor point="TOPLEFT" offsetX="10"/>
                            <Anchor point="TOPRIGHT" offsetX="-10"/>
                        </Label>
                        <Label name="$(parent)Subtitle" horizontalAlignment="CENTER">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="4"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Title" relativePoint="BOTTOMRIGHT" offsetY="4"/>
                        </Label>
                        <Control name="$(parent)Divider" inherits="ZO_PlatformStyleDynamicHorizontalDivider">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMLEFT" offsetY="4"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMRIGHT" offsetY="4"/>
                        </Control>
                        <Control name="$(parent)Buttons">
                            <Dimensions x="710" y="50"/>
                            <Anchor point="TOP" relativeTo="$(parent)Divider" relativePoint="BOTTOM" offsetY="15"/>
                            <Controls>
                                <Button name="$(parent)ChallengesButton" text="SI_TAMRIEL_TOMES_VIEW_CHALLENGES_LABEL">
                                    <Anchor point="RIGHT" relativePoint="CENTER" offsetX="-20"/>
                                </Button>
                                <Button name="$(parent)UpgradeButton" text="SI_TAMRIEL_TOMES_UPGRADE_TOME_LABEL">
                                    <Anchor point="LEFT" relativePoint="CENTER" offsetX="20"/>
                                </Button>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Book">
                    <Controls>
                        <Control name="$(parent)RewardParticleGeneratorPosition" tier="MEDIUM">
                            <Anchor point="TOPLEFT"/>
                        </Control>
                        <Control name="$(parent)Currency" resizeToFitDescendents="true">
                            <Controls>
                                <Control name="$(parent)Balance" resizeToFitDescendents="true">
                                    <Dimensions y="32"/>
                                    <Controls>
                                        <Label name="$(parent)Name" horizontalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                                            <Anchor point="LEFT"/>
                                        </Label>
                                        <Control name="$(parent)Amount" inherits="ZO_RollingMeterLabel">
                                            <Anchor point="LEFT" relativeTo="$(parent)Name" relativePoint="RIGHT" offsetX="5"/>
                                        </Control>
                                        <Texture name="$(parent)Icon" textureFile="EsoUI/Art/Icons/icon_missing.dds" layer="CONTROLS">
                                            <Dimensions x="32" y="32"/>
                                            <Anchor point="LEFT" relativeTo="$(parent)Amount" relativePoint="RIGHT" offsetX="5"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Control name="$(parent)Bonus" hidden="true" resizeToFitDescendents="true">
                                    <Controls>
                                        <Label name="$(parent)Percent" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SUCCEEDED"/>
                                        <Texture name="$(parent)Icon" textureFile="EsoUI/Art/TamrielTomes/currencyBonusArrow.dds" layer="CONTROLS">
                                            <Dimensions x="48" y="48"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Texture name="$(parent)BalanceBackdrop" textureFile="EsoUI/Art/TamrielTomes/tome_currency_backdrop.dds" hidden="true" excludeFromResizeToFitExtents="true" level="10">
                                    <Dimensions x="350" y="44"/>
                                </Texture>
                                <Texture name="$(parent)FullBackdrop" textureFile="EsoUI/Art/TamrielTomes/tome_currency_backdrop.dds" hidden="true" excludeFromResizeToFitExtents="true" level="10">
                                    <Dimensions x="350" y="88"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Control name="$(parent)GridList"/>
                        <Texture name="$(parent)PremiumGroupBorder" textureFile="EsoUI/Art/TamrielTomes/tome_group_premium_slots_border.dds" level="5">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)GridList" offsetX="25" offsetY="-30"/>
                            <Dimensions x="686" y="372"/>
                            <TextureCoords left="0" right="0.6699" top="0" bottom="0.7266"/>
                            <Controls>
                                <Label name="$(parent)Label" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" text="SI_TAMRIEL_TOMES_PREMIUM_REWARDS" level="6" modifyTextType="UPPERCASE">
                                    <Anchor point="CENTER" relativePoint="BOTTOM" offsetY="-2"/>
                                    <Controls>
                                        <Texture name="$(parent)Backdrop" textureFile="EsoUI/Art/TamrielTomes/tome_premium_bg.dds" level="4">
                                            <Anchor point="CENTER"/>
                                            <Dimensions x="512" y="32"/>
                                        </Texture>
                                    </Controls>
                                </Label>
                            </Controls>
                        </Texture>
                        <Control name="$(parent)PageNavigation" inherits="ZO_PageNavigation">
                            <Anchor point="BOTTOM" offsetY="-80"/>
                            <Controls>
                                <Texture name="$(parent)Background" textureFile="EsoUI/Art/TamrielTomes/tome_page_selection_bg.dds" level="10" excludeFromResizeToFitExtents="true">
                                    <Dimensions x="720" y="64"/>
                                    <Anchor point="CENTER"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Label name="$(parent)UnlockPointsRequired" horizontalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                            <Anchor point="BOTTOM" relativeTo="$(parent)PageNavigation" relativePoint="TOP" offsetY="-20"/>
                            <Controls>
                                <Texture name="$(parent)Background" textureFile="EsoUI/Art/TamrielTomes/tome_points_remaining_to_unlock_page_bg.dds" level="10">
                                    <Dimensions x="512" y="32"/>
                                    <Anchor point="CENTER"/>
                                </Texture>
                            </Controls>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
