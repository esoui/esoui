<GuiXml>
    <Controls>
        <Control name="ZO_TamrielTomesPurchaseReward_Shared" virtual="true">
            <OnInitialized>
                local container = self:GetNamedChild("Container")
                self.icon = container:GetNamedChild("Icon")
                self.quantityLabel = container:GetNamedChild("Quantity")
                self.backdrop = container:GetNamedChild("Backdrop")
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container">
                    <AnchorFill/>
                    <Controls>
                        <Backdrop name="$(parent)Backdrop"/>
                        <Texture name="$(parent)Icon" level="6" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
                            <Dimensions x="52" y="52"/>
                            <Anchor point="CENTER"/>
                        </Texture>
                        <Label name="$(parent)Quantity" horizontalAlignment="RIGHT" verticalAlignment="BOTTOM">
                            <Dimensions x="80"/>
                            <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Icon" offsetX="4" offsetY="4"/>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomesPurchaseVerticalDivider_Shared" virtual="true">
            <Controls>
                <Texture name="$(parent)Top" layer="CONTROLS" level="2" textureFile="EsoUI/Art/Windows/Gamepad/gp_nav1_vertDividerFlat.dds">
                    <Dimensions x="8" y="4"/>
                    <TextureCoords left="0.25" right="0.75" top="0.0" bottom="0.25"/>
                    <Anchor point="TOP"/>
                </Texture>
                <Texture name="$(parent)Bottom" layer="CONTROLS" level="2" textureFile="EsoUI/Art/Windows/Gamepad/gp_nav1_vertDividerFlat.dds">
                    <Dimensions x="8" y="4"/>
                    <TextureCoords left="0.25" right="0.75" top="0.75" bottom="1.0"/>
                    <Anchor point="BOTTOM"/>
                </Texture>
                <Texture name="$(parent)Center" layer="CONTROLS" level="2" textureFile="EsoUI/Art/Windows/Gamepad/gp_nav1_vertDividerFlat.dds">
                    <TextureCoords left="0.25" right="0.75" top="0.25" bottom="0.75"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Top" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Bottom" relativePoint="TOPRIGHT"/>
                </Texture>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_TamrielTomesPurchase_SharedTL" hidden="true" virtual="true">
            <Dimensions x="900" y="900"/>
            <Controls>
                <Label name="$(parent)Title" horizontalAlignment="CENTER" modifyTextType="UPPERCASE" text="SI_TAMRIEL_TOMES_UPGRADE_TOME_HEADER">
                    <Anchor point="TOPLEFT" offsetX="10" offsetY="20"/>
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="20"/>
                </Label>
                <Control name="$(parent)Divider" inherits="ZO_PlatformStyleDynamicHorizontalDivider">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="4"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Title" relativePoint="BOTTOMRIGHT" offsetY="4"/>
                </Control>
                <Texture name="$(parent)Image" level="3">
                    <Dimensions x="840" y="400"/>
                    <Anchor point="TOP" relativeTo="$(parent)Divider" relativePoint="BOTTOM" offsetY="15"/>
                </Texture>
                <Control name="$(parent)GridList">
                    <Anchor point="TOP" relativeTo="$(parent)Image" relativePoint="BOTTOM" offsetY="15"/>
                </Control>
                <Control name="$(parent)Buttons">
                    <Anchor point="BOTTOM" offsetY="-20"/>
                    <Controls>
                        <Control name="$(parent)Row1">
                            <Anchor point="TOP"/>
                            <Controls>
                                <Button name="$(parent)PremiumButton">
                                    <Anchor point="RIGHT" relativePoint="CENTER" offsetX="-20"/>
                                </Button>
                                <Button name="$(parent)PremiumPlusButton">
                                    <Anchor point="LEFT" relativePoint="CENTER" offsetX="20"/>
                                </Button>
                            </Controls>
                        </Control>
                        <Control name="$(parent)Row2">
                            <Anchor point="TOP" relativeTo="$(parent)Row1" relativePoint="BOTTOM" offsetY="10"/>
                            <Controls>
                                <Button name="$(parent)TokenButton">
                                    <Anchor point="CENTER"/>
                                </Button>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Texture name="$(parent)Background" textureFile="EsoUI/Art/Icons/icon_missing.dds">
                    <AnchorFill/>
                </Texture>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
