<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_TamrielTomes_KeyboardTL" inherits="ZO_TamrielTomes_SharedTL">
            <Anchor point="TOPRIGHT" offsetX="-53" offsetY="80"/>
            <OnInitialized>
                ZO_TamrielTomesScreen_Keyboard.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)PageBackground" override="true">
                    <TextureCoords left="0.959" right="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="GuiRoot"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="GuiRoot"/>
                </Texture>
                <Texture name="$(parent)BookEdge" override="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)PageBackground" offsetX="-12"/>
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)PageBackground" offsetX="-12"/>
                    <TextureCoords left="0.59375" right="0"/>
                </Texture>
                <Texture name="$(parent)BookEdgeDamage" override="true">
                    <TextureCoords left="0.59375" right="0"/>
                </Texture>
                <Control name="$(parent)Header" override="true">
                    <Controls>
                        <Label name="$(parent)Title" override="true" font="ZoFontWinH1"/>
                        <Label name="$(parent)Subtitle" override="true" font="ZoFontWinH3"/>
                        <Control name="$(parent)Divider" override="true" inherits="ZO_PlatformStyleDynamicHorizontalDivider_Keyboard_Template"/>
                        <Control name="$(parent)Buttons" override="true">
                            <Controls>
                                <Button name="$(parent)ChallengesButton" override="true" inherits="ZO_DefaultButton">
                                    <Dimensions x="270"/>
                                </Button>
                                <Button name="$(parent)UpgradeButton" override="true" inherits="ZO_DefaultButton">
                                    <Dimensions x="270"/>
                                </Button>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Book" override="true">
                    <Dimensions x="860" y="900"/>
                    <Anchor point="TOP" relativeTo="$(parent)Header" relativePoint="BOTTOM" offsetY="20"/>
                    <Controls>
                        <Control name="$(parent)Currency" override="true">
                            <Anchor point="RIGHT" relativePoint="TOPRIGHT" offsetY="35"/>
                            <Controls>
                                <Control name="$(parent)Balance" override="true">
                                    <Anchor point="TOPRIGHT" offsetX="-15" offsetY="5"/>
                                    <Controls>
                                        <Label name="$(parent)Name" override="true" font="ZoFontHeader2"/>
                                    </Controls>
                                </Control>
                                <Control name="$(parent)Bonus" override="true">
                                    <Anchor point="TOPRIGHT" offsetX="-15" offsetY="35"/>
                                    <Controls>
                                        <Label name="$(parent)Percent" override="true" font="ZoFontHeader2">
                                            <Anchor point="RIGHT" relativePoint="TOPRIGHT" offsetX="-48" offsetY="24"/>
                                        </Label>
                                        <Texture name="$(parent)Icon" override="true" textureFile="EsoUI/Art/TamrielTomes/currencyBonusArrow.dds">
                                            <Anchor point="TOPRIGHT" offsetX="4"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Texture name="$(parent)BalanceBackdrop" override="true">
                                    <Anchor point="RIGHT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" relativeTo="$(parent)Balance" constrains="Y"/>
                                    <TextureCoords left="0.1445" top="0" right="1" bottom="0.6953"/>
                                </Texture>
                                <Texture name="$(parent)FullBackdrop" override="true">
                                    <Anchor point="RIGHT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" constrains="Y"/>
                                    <TextureCoords left="0.1445" top="0" right="1" bottom="0.6953"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Control name="$(parent)GridList" override="true" inherits="ZO_GridScrollList_Keyboard">
                            <Anchor point="TOP" offsetY="120"/>
                            <Dimensions x="ZO_TAMRIEL_TOMES_GRID_LIST_WIDTH" y="ZO_TAMRIEL_TOMES_GRID_LIST_HEIGHT"/>
                        </Control>
                        <Texture name="$(parent)PremiumGroupBorder" override="true">
                            <Controls>
                                <Label name="$(parent)Label" override="true" font="ZoFontHeader2"/>
                            </Controls>
                        </Texture>
                        <Control name="$(parent)PageNavigation" override="true" inherits="ZO_PageNavigation_Keyboard"/>
                        <Label name="$(parent)UnlockPointsRequired" override="true" font="ZoFontHeader2"/>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
