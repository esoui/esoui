<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_TamrielTomes_KeyboardTL" inherits="ZO_TamrielTomes_SharedTL">
            <Anchor point="BOTTOMRIGHT" offsetX="-10"/>
            <OnInitialized>
                ZO_TamrielTomesScreen_Keyboard.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)PageBackground" override="true">
                    <TextureCoords left="0" right="0.959"/>
                    <Anchor point="TOPRIGHT" offsetX="10" relativePoint="BOTTOMRIGHT" offsetY="-1025"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="10"/>
                </Texture>
                <Control name="$(parent)Header" override="true">
                    <Controls>
                        <Label name="$(parent)Title" override="true" font="ZoFontCallout"/>
                        <Label name="$(parent)Subtitle" override="true" font="ZoFontHeader3"/>
                        <Control name="$(parent)Buttons" override="true">
                            <Controls>
                                <Button name="$(parent)ChallengesButton" override="true" inherits="ZO_DefaultButton" font="ZoFontWinH2">
                                    <Dimensions x="270" y="38"/>
                                </Button>
                                <Button name="$(parent)UpgradeButton" override="true" inherits="ZO_DefaultButton" font="ZoFontWinH2">
                                    <Dimensions x="270" y="38"/>
                                </Button>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Book" override="true">
                    <Dimensions x="860" y="900"/>
                    <Anchor point="TOP" relativeTo="$(parent)Header" relativePoint="BOTTOM" offsetY="22"/>
                    <Controls>
                        <Control name="$(parent)Currency" override="true">
                            <Anchor point="RIGHT" relativePoint="TOPRIGHT" offsetY="28"/>
                            <Controls>
                                <Control name="$(parent)Balance" override="true">
                                    <Anchor point="TOPRIGHT" offsetX="-15"/>
                                    <Controls>
                                        <Texture name="$(parent)Icon" override="true">
                                            <Anchor point="RIGHT"/>
                                        </Texture>
                                        <Control name="$(parent)Amount" override="true" inherits="ZO_RollingMeterLabel">
                                            <Anchor point="RIGHT" relativeTo="$(parent)Icon" relativePoint="LEFT" offsetX="-8"/>
                                        </Control>
                                        <Label name="$(parent)Name" override="true" font="ZoFontHeader2">
                                            <Anchor point="RIGHT" relativeTo="$(parent)Amount" relativePoint="LEFT" offsetX="-8"/>
                                        </Label>
                                    </Controls>
                                </Control>
                                <Control name="$(parent)Bonus" override="true">
                                    <Anchor point="TOPRIGHT" offsetX="-15" offsetY="16"/>
                                    <Controls>
                                        <Label name="$(parent)Percent" override="true" font="ZoFontHeader2">
                                            <Anchor point="RIGHT" relativePoint="TOPRIGHT" offsetX="-48" offsetY="24"/>
                                        </Label>
                                        <Texture name="$(parent)Icon" override="true" textureFile="EsoUI/Art/TamrielTomes/currencyBonusArrow.dds">
                                            <Anchor point="TOPRIGHT" offsetX="4"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Texture name="$(parent)BalanceBackdrop" override="true">
                                    <Anchor point="RIGHT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" relativeTo="$(parent)Balance" offsetY="-5" constrains="Y"/>
                                    <TextureCoords left="0.1445" top="0" right="1" bottom="0.6953"/>
                                </Texture>
                                <Texture name="$(parent)FullBackdrop" override="true">
                                    <Anchor point="RIGHT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" constrains="Y" offsetY="-5"/>
                                    <TextureCoords left="0.1445" top="0" right="1" bottom="0.6953"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Control name="$(parent)GridList" override="true" inherits="ZO_GridScrollList_Keyboard">
                            <Anchor point="TOP" offsetX="10" offsetY="75"/>
                            <Dimensions x="ZO_TAMRIEL_TOMES_GRID_LIST_WIDTH" y="ZO_TAMRIEL_TOMES_GRID_LIST_HEIGHT"/>
                            <Controls>
                                <Control name="$(parent)Container" override="true">
                                    <Anchor point="TOPLEFT" offsetY="-21"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Control>
                            </Controls>
                        </Control>
                        <Texture name="$(parent)PremiumGroupBorder" override="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)GridList" offsetX="-22" offsetY="-14"/>
                            <Controls>
                                <Label name="$(parent)Label" override="true" font="ZoFontHeader2"/>
                            </Controls>
                        </Texture>
                        <Control name="$(parent)PageNavigation" override="true" inherits="ZO_PageNavigation_Keyboard">
                            <Anchor point="TOP" relativeTo="$(parent)GridList" relativePoint="BOTTOM" offsetX="-10" offsetY="4"/>
                        </Control>
                        <Label name="$(parent)UnlockPointsRequired" override="true" font="ZoFontHeader"/>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
