<GuiXml>
    <Controls>
        <Control name="ZO_TamrielTomesIntroHighlight_Gamepad" inherits="ZO_TamrielTomesIntroHighlight_Shared" virtual="true">
            <Controls>
                <Label name="$(parent)Title" override="true" font="ZoFontGamepadBold34"/>
                <Label name="$(parent)BodyText" override="true" font="ZoFontGamepadCondensed36"/>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_TamrielTomesIntro_GamepadTL" inherits="ZO_TamrielTomesIntro_SharedTL">
            <OnInitialized>
                ZO_TamrielTomesIntroScreen_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)BG">
                    <AnchorFill/>
                    <Controls>
                        <Texture name="$(parent)Fill" color="000000" alpha="0.8">
                            <AnchorFill/>
                        </Texture>
                        <Backdrop name="$(parent)EdgeFrame" inherits="ZO_GamepadNormalOutlineHighlight" tier="HIGH" excludeFromResizeToFitExtents="true">
                            <Anchor point="TOPLEFT" offsetX="-4" offsetY="-4"/>
                            <Anchor point="BOTTOMRIGHT" offsetX="4" offsetY="4"/>
                        </Backdrop>
                    </Controls>
                </Control>
                <Label name="$(parent)Title" override="true" font="ZoFontGamepad54"/>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
