<GuiXml>
    <Controls>
        <Button name="ZO_TamrielTomes_GamepadButtonTemplate" font="ZoFontGamepad27" modifyTextType="UPPERCASE" verticalAlignment="CENTER" virtual="true">
            <Dimensions x="270" y="40"/>
            <FontColors normalColor="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" disabledColor="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_DISABLED"/>
            <Controls>
                <Backdrop name="$(parent)Border" inherits="ZO_GamepadNormalOutlineHighlight" tier="HIGH" layer="OVERLAY" level="5" blendMode="ADD">
                    <Anchor point="TOPLEFT" offsetX="-10" offsetY="-2"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="10" offsetY="2"/>
                </Backdrop>
                <Backdrop name="$(parent)Highlight" inherits="ZO_GamepadWhiteOutlineThick" tier="HIGH" layer="OVERLAY" level="6" blendMode="ADD" hidden="true" excludeFromResizeToFitExtents="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Border" offsetX="-3" offsetY="-3"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Border" offsetX="3" offsetY="3"/>
                </Backdrop>
                <Texture name="$(parent)Background" color="INTERFACE_COLOR_TYPE_GENERAL:INTERFACE_GENERAL_COLOR_BLACK" alpha="1" level="7" excludeFromResizeToFitExtents="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Border"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Border"/>
                </Texture>
            </Controls>
        </Button>
        <TopLevelControl name="ZO_TamrielTomes_GamepadTL" inherits="ZO_TamrielTomes_SharedTL">
            <Anchor point="TOPLEFT" offsetY="25"/>
            <OnInitialized>
                ZO_TamrielTomesScreen_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)PageBackground" override="true">
                    <Anchor point="TOPLEFT" relativeTo="GuiRoot" offsetX="-150"/>
                    <Anchor point="BOTTOMLEFT" relativeTo="GuiRoot" offsetX="-150"/>
                    <TextureCoords left="0" right="0.959" top="0.035"/>
                </Texture>
                <Texture name="$(parent)BookEdge" override="true">
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)PageBackground" offsetX="12"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)PageBackground" offsetX="12"/>
                    <TextureCoords left="0" right="0.59375"/>
                </Texture>
                <Texture name="$(parent)BookEdgeDamage" override="true">
                    <TextureCoords left="0" right="0.59375"/>
                </Texture>
                <Control name="$(parent)Header" override="true">
                    <Anchor point="TOP" offsetY="10"/>
                    <Controls>
                        <Label name="$(parent)Title" override="true" font="ZoFontGamepad34"/>
                        <Label name="$(parent)Subtitle" override="true" font="ZoFontGamepad27"/>
                        <Control name="$(parent)Divider" override="true" inherits="ZO_PlatformStyleDynamicHorizontalDivider_Gamepad_Template">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMLEFT" offsetX="4" offsetY="4"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMRIGHT" offsetX="-95" offsetY="4"/>
                        </Control>
                        <Control name="$(parent)Buttons" override="true">
                            <Controls>
                                <Button name="$(parent)ChallengesButton" override="true" inherits="ZO_TamrielTomes_GamepadButtonTemplate"/>
                                <Button name="$(parent)UpgradeButton" override="true" inherits="ZO_TamrielTomes_GamepadButtonTemplate"/>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Book" override="true">
                    <Dimensions x="860" y="835"/>
                    <Anchor point="TOP" relativeTo="$(parent)Header" relativePoint="BOTTOM"/>
                    <Controls>
                        <Control name="$(parent)Currency" override="true">
                            <Anchor point="LEFT" relativePoint="TOPLEFT" offsetY="40"/>
                            <Controls>
                                <Control name="$(parent)Balance" override="true">
                                    <Anchor point="TOPLEFT" offsetX="15"/>
                                    <Controls>
                                        <Label name="$(parent)Name" override="true" font="ZoFontGamepad27" modifyTextType="UPPERCASE">
                                            <Anchor point="LEFT"/>
                                        </Label>
                                        <Control name="$(parent)Amount" override="true" inherits="ZO_RollingMeterLabel">
                                            <Anchor point="LEFT" relativeTo="$(parent)Name" relativePoint="RIGHT" offsetX="8"/>
                                        </Control>
                                        <Texture name="$(parent)Icon" override="true">
                                            <Anchor point="LEFT" relativeTo="$(parent)Amount" relativePoint="RIGHT" offsetX="8"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Control name="$(parent)Bonus" override="true">
                                    <Anchor point="TOPLEFT" offsetX="15" offsetY="32"/>
                                    <Controls>
                                        <Label name="$(parent)Percent" override="true" font="ZoFontGamepad27" modifyTextType="UPPERCASE">
                                            <Anchor point="LEFT" relativePoint="TOPLEFT" offsetY="24"/>
                                        </Label>
                                        <Texture name="$(parent)Icon" override="true" textureFile="EsoUI/Art/TamrielTomes/currencyBonusArrow.dds">
                                            <Anchor point="LEFT" relativeTo="$(parent)Percent" relativePoint="RIGHT" offsetX="4"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Texture name="$(parent)BalanceBackdrop" override="true">
                                    <Anchor point="LEFT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" relativeTo="$(parent)Balance" constrains="Y"/>
                                    <TextureCoords left="1" top="0" right="0.1445" bottom="0.6953"/>
                                </Texture>
                                <Texture name="$(parent)FullBackdrop" override="true">
                                    <Anchor point="LEFT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" constrains="Y"/>
                                    <TextureCoords left="1" top="0" right="0.1445" bottom="0.6953"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Control name="$(parent)GridList" override="true" inherits="ZO_GridScrollList_NotAnchored_Gamepad">
                            <Anchor point="TOP" offsetX="-35" offsetY="120"/>
                            <Dimensions x="ZO_TAMRIEL_TOMES_GRID_LIST_WIDTH" y="ZO_TAMRIEL_TOMES_GRID_LIST_HEIGHT"/>
                            <Controls>
                                <Control name="$(parent)Container" override="true">
                                    <Anchor point="TOPLEFT" offsetY="-21"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Control>
                            </Controls>
                        </Control>
                        <Texture name="$(parent)PremiumGroupBorder" override="true">
                            <Controls>
                                <Label name="$(parent)Label" override="true" font="ZoFontGamepad27"/>
                            </Controls>
                        </Texture>
                        <Label name="$(parent)UnlockPointsRequired" override="true" font="ZoFontGamepadCondensed34"/>
                        <Control name="$(parent)PageNavigation" override="true" inherits="ZO_PageNavigation_Gamepad"/>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
