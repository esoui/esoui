<GuiXml>
    <Controls>
        <Button name="ZO_TamrielTomes_GamepadButtonTemplate" font="ZoFontGamepad27" modifyTextType="UPPERCASE" verticalAlignment="CENTER" virtual="true">
            <Dimensions x="270" y="40"/>
            <FontColors normalColor="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" disabledColor="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_DISABLED"/>
            <Controls>
                <Backdrop name="$(parent)Border" inherits="ZO_GamepadNormalOutlineHighlight" tier="HIGH" layer="OVERLAY" level="5" blendMode="ADD">
                    <Anchor point="TOPLEFT" offsetX="-10" offsetY="-2"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="10" offsetY="2"/>
                </Backdrop>
                <Backdrop name="$(parent)Highlight" inherits="ZO_GamepadWhiteOutlineThick" tier="HIGH" layer="OVERLAY" level="6" blendMode="ADD" hidden="true" excludeFromResizeToFitExtents="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Border" offsetX="-3" offsetY="-3"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Border" offsetX="3" offsetY="3"/>
                </Backdrop>
                <Texture name="$(parent)Background" color="INTERFACE_COLOR_TYPE_GENERAL:INTERFACE_GENERAL_COLOR_BLACK" alpha="1" level="7" excludeFromResizeToFitExtents="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Border"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Border"/>
                </Texture>
            </Controls>
        </Button>
        <Control name="ZO_TamrielTomeSeasonEntry_Gamepad" inherits="ZO_TamrielTomeSeasonEntry_Shared" mouseEnabled="true" virtual="true">
            <Dimensions x="ZO_TAMRIEL_TOME_SEASON_ENTRY_GAMEPAD_WIDTH" y="ZO_TAMRIEL_TOME_SEASON_ENTRY_GAMEPAD_HEIGHT"/>
            <Controls>
                <Texture name="$(parent)Image" override="true">
                    <Dimensions x="ZO_TAMRIEL_TOME_SEASON_ENTRY_IMAGE_GAMEPAD_WIDTH" y="ZO_TAMRIEL_TOME_SEASON_ENTRY_IMAGE_GAMEPAD_HEIGHT"/>
                </Texture>
                <Texture name="$(parent)ImageGlow" override="true">
                    <Dimensions x="ZO_TAMRIEL_TOME_SEASON_ENTRY_IMAGE_GAMEPAD_WIDTH" y="ZO_TAMRIEL_TOME_SEASON_ENTRY_IMAGE_GAMEPAD_HEIGHT"/>
                </Texture>
                <Label name="$(parent)Name" override="true" font="ZoFontGamepadBold34">
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="8"/>
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8"/>
                </Label>
                <Label name="$(parent)Rewards" override="true" font="ZoFontGamepadBold27">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Name" relativePoint="BOTTOMLEFT" offsetY="4"/>
                </Label>
                <Label name="$(parent)RewardCount" override="true" font="ZoFontGamepadBold27"/>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_SelectTamrielTomeSeason_Gamepad" inherits="ZO_CustomCenteredGamepadDialogTemplate" resizeToFitDescendents="true" resizeToFitConstrains="Y">
            <Dimensions x="ZO_TAMRIEL_TOME_SEASON_DIALOG_GAMEPAD_WIDTH"/>
            <ResizeToFitPadding width="40" height="72"/>
            <OnInitialized name="TamrielTomes">
                ZO_SelectTamrielTomeSeasonDialog_Gamepad.OnInitialized(self)
            </OnInitialized>
            <OnEffectivelyHidden name="TamrielTomes">
                ZO_SelectTamrielTomeSeasonDialog_Gamepad.OnHidden(self)
            </OnEffectivelyHidden>
            <Controls>
                <Label name="$(parent)Title" font="ZoFontGamepad42" horizontalAlignment="CENTER" modifyTextType="UPPERCASE">
                    <Anchor point="TOPLEFT" offsetX="5" offsetY="38"/>
                    <Anchor point="TOPRIGHT" offsetX="-5" offsetY="38"/>
                </Label>
                <Control name="$(parent)DividerSimple" inherits="ZO_GamepadHeaderHorizontalDivider">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="60"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Title" relativePoint="BOTTOMRIGHT" offsetX="-60" offsetY="30"/>
                </Control>
                <Control name="$(parent)Content" override="true">
                    <Anchor point="TOP" relativeTo="$(parent)DividerSimple" relativePoint="BOTTOM" offsetY="30"/>
                    <Dimensions x="ZO_TAMRIEL_TOME_SEASON_GRID_GAMEPAD_WIDTH"/>
                    <Controls>
                        <Control name="$(parent)TomesGrid" inherits="ZO_GridScrollList_Gamepad">
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                            <!-- Minimum height dimension constraint is set by ZO_SelectTamrielTomeSeasonDialog_Gamepad:PopulateGridList() -->
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Close" inherits="ZO_CustomDialogButton_Gamepad"/>
                <Control name="$(parent)Select" inherits="ZO_CustomDialogButton_Gamepad"/>
            </Controls>
        </TopLevelControl>
        <Label name="ZO_TamrielTomeSeasonEndInfoBulletLabel_Gamepad" font="ZoFontGamepad27" virtual="true" level="2">
            <Controls>
                <Texture name="$(parent)Bullet" textureFile="EsoUI/Art/Miscellaneous/Gamepad/gp_bullet_ochre.dds" level="3">
                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-8"/>
                    <Dimensions x="32" y="32"/>
                </Texture>
            </Controls>
        </Label>
        <Control name="ZO_TamrielTomeSeasonEndEntry_Gamepad" inherits="ZO_TamrielTomeSeasonEndEntry_Shared" virtual="true">
            <Controls>
                <Texture name="$(parent)RewardIcon" override="true">
                    <Controls>
                        <Label name="$(parent)Quantity" override="true" font="ZoFontGamepad27"/>
                    </Controls>
                </Texture>
                <Label name="$(parent)RewardName" override="true" font="ZoFontGamepad27"/>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_TamrielTomeSeasonEnd_Gamepad" inherits="ZO_TamrielTomeSeasonEnd_Shared ZO_CustomCenteredGamepadDialogTemplate" resizeToFitDescendents="true" resizeToFitConstrains="Y">
            <Dimensions x="ZO_TAMRIEL_TOME_SEASON_END_DIALOG_WIDTH"/>
            <ResizeToFitPadding width="0" height="50"/>
            <OnInitialized name="TamrielTomes">
                ZO_TamrielTomeSeasonEndDialog_Gamepad.OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Summary" override="true">
                    <Anchor point="TOP" offsetY="20"/>
                    <Controls>
                        <Label name="$(parent)SeasonName" override="true" font="ZoFontGamepadBold34"/>
                        <Label name="$(parent)SeasonRewards" override="true" font="ZoFontGamepadBold27"/>
                        <Label name="$(parent)SeasonRewardCount" override="true" font="ZoFontGamepadBold27"/>
                        <Label name="$(parent)PremiumExplanation" override="true" inherits="ZO_TamrielTomeSeasonEndInfoBulletLabel_Gamepad"/>
                        <Label name="$(parent)TomePointRollover" override="true" inherits="ZO_TamrielTomeSeasonEndInfoBulletLabel_Gamepad"/>
                        <Label name="$(parent)GoldRollover" override="true" inherits="ZO_TamrielTomeSeasonEndInfoBulletLabel_Gamepad"/>
                        <Label name="$(parent)ClaimedRewards" override="true" font="ZoFontGamepad27"/>
                    </Controls>
                </Control>
                <Control name="$(parent)RewardsGrid" inherits="ZO_GridScrollList_Gamepad" level="2">
                    <Anchor point="TOP" relativeTo="$(parent)Summary" relativePoint="BOTTOM" offsetY="12"/>
                    <Dimensions x="ZO_TAMRIEL_TOME_SEASON_END_GRID_WIDTH"/>
                    <!-- Minimum height dimension constraint is set by ZO_SelectTamrielTomeSeasonEndDialog_Shared:PopulateGridList() -->
                    <Controls>
                        <Control name="$(parent)Container" override="true">
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Control>
                        <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" excludeFromResizeToFitExtents="true" level="3"/>
                    </Controls>
                </Control>
                <Control name="$(parent)Close" inherits="ZO_CustomDialogButton_Gamepad"/>
            </Controls>
        </TopLevelControl>
        <TopLevelControl name="ZO_TamrielTomes_GamepadTL" inherits="ZO_TamrielTomes_SharedTL">
            <Anchor point="LEFT" offsetX="13" offsetY="24"/>
            <Dimensions x="850"/>
            <OnInitialized>
                ZO_TamrielTomesScreen_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)PageBackground" override="true">
                    <Anchor point="TOPLEFT" relativeTo="GuiRoot" offsetY="-40"/>
                    <Anchor point="BOTTOMLEFT" relativeTo="GuiRoot"/>
                    <TextureCoords left="0.959" right="0"/>
                </Texture>
                <Control name="$(parent)Header" override="true">
                    <Anchor point="TOP"/>
                    <Dimensions x="850" y="150"/>
                    <Controls>
                        <Label name="$(parent)Title" override="true" font="ZoFontGamepadBold48">
                            <Anchor point="TOPLEFT" offsetX="80"/>
                            <Anchor point="TOPRIGHT" offsetX="-80"/>
                        </Label>
                        <Label name="$(parent)Subtitle" override="true" font="ZoFontGamepad27"/>
                        <Control name="$(parent)Buttons" override="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMLEFT" offsetY="12"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Subtitle" relativePoint="BOTTOMRIGHT" offsetY="12"/>
                            <Dimensions y="40"/>
                            <Controls>
                                <Button name="$(parent)ChallengesButton" override="true" inherits="ZO_TamrielTomes_GamepadButtonTemplate"/>
                                <Button name="$(parent)UpgradeButton" override="true" inherits="ZO_TamrielTomes_GamepadButtonTemplate"/>
                            </Controls>
                        </Control>
                        <Button name="$(parent)SelectTomeButton" override="true">
                            <Anchor point="LEFT" relativeTo="$(parent)ButtonsUpgradeButton" relativePoint="RIGHT" offsetX="20"/>
                            <Textures normal="EsoUI/Art/TamrielTomes/Gamepad/gp_view_tomes.dds" pressed="EsoUI/Art/TamrielTomes/Gamepad/gp_view_tomes.dds" mouseOver="EsoUI/Art/TamrielTomes/Gamepad/gp_view_tomes.dds" disabled="EsoUI/Art/TamrielTomes/Gamepad/gp_view_tomes.dds"/>
                        </Button>
                        <Control name="$(parent)SelectTomeKeybind" inherits="ZO_KeybindButton_Gamepad">
                            <Anchor point="LEFT" relativeTo="$(parent)SelectTomeButton" relativePoint="RIGHT"/>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)Book" override="true">
                    <Dimensions x="850" y="835"/>
                    <Anchor point="TOP" relativeTo="$(parent)Header" relativePoint="BOTTOM" offsetY="6"/>
                    <Controls>
                        <Control name="$(parent)Currency" override="true">
                            <Anchor point="TOPLEFT" offsetY="10"/>
                            <Controls>
                                <Control name="$(parent)Balance" override="true">
                                    <Anchor point="TOPLEFT" offsetX="15"/>
                                    <Controls>
                                        <Label name="$(parent)Name" override="true" font="ZoFontGamepad25" modifyTextType="UPPERCASE">
                                            <Anchor point="LEFT"/>
                                        </Label>
                                        <Control name="$(parent)Amount" override="true" inherits="ZO_RollingMeterLabel">
                                            <Anchor point="LEFT" relativeTo="$(parent)Name" relativePoint="RIGHT" offsetX="8"/>
                                        </Control>
                                        <Texture name="$(parent)Icon" override="true">
                                            <Anchor point="LEFT" relativeTo="$(parent)Amount" relativePoint="RIGHT" offsetX="8"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Control name="$(parent)Bonus" override="true">
                                    <Anchor point="TOPLEFT" offsetX="15" offsetY="22"/>
                                    <Controls>
                                        <Label name="$(parent)Percent" override="true" font="ZoFontGamepad25" modifyTextType="UPPERCASE">
                                            <Anchor point="LEFT" relativePoint="TOPLEFT" offsetY="21"/>
                                        </Label>
                                        <Texture name="$(parent)Icon" override="true" textureFile="EsoUI/Art/TamrielTomes/currencyBonusArrow.dds">
                                            <Anchor point="LEFT" relativeTo="$(parent)Percent" relativePoint="RIGHT" offsetX="4"/>
                                        </Texture>
                                    </Controls>
                                </Control>
                                <Texture name="$(parent)BalanceBackdrop" override="true">
                                    <Anchor point="LEFT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" relativeTo="$(parent)Balance" constrains="Y"/>
                                    <Dimensions x="350" y="48"/>
                                    <TextureCoords left="1" top="0" right="0.1445" bottom="0.6953"/>
                                </Texture>
                                <Texture name="$(parent)FullBackdrop" override="true">
                                    <Anchor point="LEFT" relativeTo="GuiRoot" constrains="X"/>
                                    <Anchor point="CENTER" constrains="Y" offsetY="-7"/>
                                    <Dimensions x="350" y="64"/>
                                    <TextureCoords left="1" top="0" right="0.1445" bottom="0.6953"/>
                                </Texture>
                            </Controls>
                        </Control>
                        <Control name="$(parent)GridList" override="true" inherits="ZO_GridScrollList_NotAnchored_Gamepad">
                            <Anchor point="TOP" offsetY="80" offsetX="6"/>
                            <Dimensions x="ZO_TAMRIEL_TOMES_GRID_LIST_WIDTH" y="ZO_TAMRIEL_TOMES_GRID_LIST_HEIGHT"/>
                            <Controls>
                                <Control name="$(parent)Container" override="true">
                                    <Anchor point="TOPLEFT" offsetY="-15"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Control>
                            </Controls>
                        </Control>
                        <Texture name="$(parent)PremiumGroupBorder" override="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)GridList" offsetX="-22" offsetY="-8"/>
                            <Controls>
                                <Label name="$(parent)Label" override="true" font="ZoFontGamepad27"/>
                            </Controls>
                        </Texture>
                        <Control name="$(parent)PageNavigation" override="true" inherits="ZO_PageNavigation_Gamepad">
                            <Anchor point="TOP" relativeTo="$(parent)GridList" relativePoint="BOTTOM" offsetX="-10" offsetY="30"/>
                        </Control>
                        <Label name="$(parent)UnlockPointsRequired" override="true" font="ZoFontGamepadCondensed36">
                            <Anchor point="TOP" relativeTo="$(parent)GridList" relativePoint="BOTTOM" offsetX="-10" offsetY="-28"/>
                            <Controls>
                                <Texture name="$(parent)Background" override="true">
                                    <Dimensions x="660" y="45"/>
                                </Texture>
                            </Controls>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
