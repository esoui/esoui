<GuiXml>
    <Controls>
        <Backdrop name="ZO_TamrielTomes_Reward_Gamepad_Highlight_Template" centerColor="00000000" virtual="true"/>
        <Control name="ZO_TamrielTomesReward_Template_Gamepad" inherits="ZO_TamrielTomesReward_Template_Shared" virtual="true">
            <OnInitialized>
                ZO_TamrielTomesReward_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Backdrop name="$(parent)Highlight" inherits="ZO_GamepadWhiteOutlineHighlight" excludeFromResizeToFitExtents="true" level="1" hidden="true" inheritScale="false">
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Backdrop>
                <Control name="$(parent)Reward" override="true">
                    <Controls>
                        <Label name="$(parent)Quantity" override="true" font="ZoFontGamepad25" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                            <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Icon" offsetX="3" offsetY="3"/>
                        </Label>
                        <Texture name="$(parent)Check" override="true">
                            <Dimensions x="64" y="64"/>
                        </Texture>
                    </Controls>
                </Control>
                <Label name="$(parent)Cost" override="true" font="ZoFontGamepad25" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"/>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomes_RewardDivider_FullWidth_Gamepad" inherits="ZO_TamrielTomes_RewardDivider_FullWidth_Shared" virtual="true"/>
        <Control name="ZO_TamrielTomes_RewardTile_1xWidth_Gamepad" inherits="ZO_TamrielTomes_RewardTile_1xWidth_Shared ZO_Tile_Gamepad_Control" virtual="true">
            <OnInitialized>
                ZO_TamrielTomes_RewardTile_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Reward" override="true" inherits="ZO_TamrielTomesReward_Template_Gamepad"/>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomes_RewardTile_2xWidth_Left_Gamepad" inherits="ZO_TamrielTomes_RewardTile_2xWidth_Left_Shared ZO_Tile_Gamepad_Control" virtual="true">
            <OnInitialized>
                ZO_TamrielTomes_RewardTile_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Reward" override="true" inherits="ZO_TamrielTomesReward_Template_Gamepad"/>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomes_RewardTile_2xWidth_Right_Gamepad" inherits="ZO_TamrielTomes_RewardTile_2xWidth_Right_Shared ZO_Tile_Gamepad_Control" virtual="true">
            <OnInitialized>
                ZO_TamrielTomes_RewardTile_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Reward" override="true" inherits="ZO_TamrielTomesReward_Template_Gamepad"/>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomes_RewardTile_2_5xWidth_Left_Gamepad" inherits="ZO_TamrielTomes_RewardTile_2_5xWidth_Left_Shared ZO_Tile_Gamepad_Control" virtual="true">
            <OnInitialized>
                ZO_TamrielTomes_RewardTile_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Reward" override="true" inherits="ZO_TamrielTomesReward_Template_Gamepad"/>
            </Controls>
        </Control>
        <Control name="ZO_TamrielTomes_RewardTile_2_5xWidth_Right_Gamepad" inherits="ZO_TamrielTomes_RewardTile_2_5xWidth_Right_Shared ZO_Tile_Gamepad_Control" virtual="true">
            <OnInitialized>
                ZO_TamrielTomes_RewardTile_Gamepad.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Reward" override="true" inherits="ZO_TamrielTomesReward_Template_Gamepad"/>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
