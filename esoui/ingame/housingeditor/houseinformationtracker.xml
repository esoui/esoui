<GuiXml>
    <Controls>
        <Control name="ZO_HouseInformationTracker_Template" inherits="ZO_HUDTracker_Base_Template" virtual="true">
            <OnInitialized>
                ZO_HouseInformationTracker_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container" override="true">
                    <Controls>
                        <Label name="$(parent)Population" inherits="ZO_HUDTracker_Base_SubLabel_Template">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)SubLabel" relativePoint="BOTTOMRIGHT"/>
                        </Label>
                        <Label name="$(parent)Tags" inherits="ZO_HUDTracker_Base_SubLabel_Template">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Population" relativePoint="BOTTOMRIGHT"/>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
