<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_HousingFurnitureRetrieveTo_GamepadTopLevel" hidden="true" resizeToFitDescendents="true" tier="HIGH">
            <Anchor point="BOTTOM" relativeTo="GuiRoot" offsetY="-150" />
            <DimensionConstraints minX="300" />
            <ResizeToFitPadding width="24" height="12" />

            <OnInitialized>
                ZO_HousingFurnitureRetrieveTo_Gamepad.OnControlInitialized(self)
            </OnInitialized>

            <Controls>
                <Texture name="$(parent)Background" color="000000" excludeFromResizeToFitExtents="true">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Texture>

                <Texture name="$(parent)LeftBorder" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" excludeFromResizeToFitExtents="true">
                    <Dimensions x="2" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMLEFT" />
                </Texture>

                <Texture name="$(parent)RightBorder" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" excludeFromResizeToFitExtents="true">
                    <Dimensions x="2" />
                    <Anchor point="TOPRIGHT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Texture>

                <Texture name="$(parent)TopBorder" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" excludeFromResizeToFitExtents="true">
                    <Dimensions y="2" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
                </Texture>

                <Texture name="$(parent)BottomBorder" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" excludeFromResizeToFitExtents="true">
                    <Dimensions y="2" />
                    <Anchor point="BOTTOMLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Texture>

                <Label name="$(parent)Title" font="ZoFontGamepad34" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" modifyTextType="UPPERCASE" text="SI_HOUSING_EDITOR_RETRIEVE_TO">
                    <Anchor point="TOP" offsetY="6" />
                </Label>

                <Label name="$(parent)Bag" font="ZoFontGamepad34" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <Anchor point="TOP" relativeTo="$(parent)Title" relativePoint="BOTTOM" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>