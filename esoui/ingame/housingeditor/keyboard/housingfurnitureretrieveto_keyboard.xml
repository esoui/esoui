                </Backdrop>
                <Label name="$(parent)Title" font="ZoFontHeader4" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" modifyTextType="UPPERCASE" text="SI_HOUSING_EDITOR_RETRIEVE_TO">
                    <Anchor point="TOP" offsetY="16"/>
                </Label>
                <Control name="$(parent)Bag" inherits="ZO_ComboBoxResizeToFit">
                    <Anchor point="TOP" relativeTo="$(parent)Title" relativePoint="BOTTOM" offsetY="8"/>
                    <DimensionConstraints minX="250" maxX="350"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
