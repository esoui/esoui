<GuiXml>
    <Controls>
        <Control name="ZO_ReturningPlayerRewardsReward_Shared" virtual="true">
            <OnInitialized>
                local container = self:GetNamedChild("Container")
                self.icon = container:GetNamedChild("Icon")
                self.quantityLabel = container:GetNamedChild("Quantity")
                self.completeMark = self:GetNamedChild("CompleteMark")
                self.backdrop = container:GetNamedChild("Backdrop")
            </OnInitialized>

            <Controls>
                <Control name="$(parent)Container">
                    <AnchorFill />

                    <Controls>
                        <Backdrop name="$(parent)Backdrop" />

                        <Texture name="$(parent)Icon" level="6" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
                            <Dimensions x="52" y="52"/>
                            <Anchor point="CENTER" />
                        </Texture>

                        <Label name="$(parent)Quantity" horizontalAlignment="RIGHT" verticalAlignment="BOTTOM">
                            <Dimensions x="80" />
                            <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Icon" offsetX="4" offsetY="4"/>
                        </Label>
                    </Controls>
                </Control>

                <Texture name="$(parent)CompleteMark" textureFile="EsoUI/Art/DailyLoginRewards/dailyloginrewards_claimed_stamp.dds" layer="OVERLAY" level="1" hidden="true">
                    <Dimensions x="64" y="64" />
                    <Anchor point="CENTER" relativeTo="$(parent)Container"/>
                </Texture>
            </Controls>
        </Control>

        <Control name="ZO_ReturningPlayerRewardsDailyReward_Shared" inherits="ZO_ReturningPlayerRewardsReward_Shared" virtual="true">
            <OnInitialized name="DailyReward_Shared">
                self.dayLabel = self:GetNamedChild("Day")
            </OnInitialized>

            <Controls>
                <Label name="$(parent)Day" horizontalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                    <Anchor point="TOP" relativeTo="$(parent)Container" relativePoint="BOTTOM" offsetY="3" />
                </Label>
            </Controls>
        </Control>

        <Control name="ZO_ReturningPlayerRewardsRewardInfoContainer_Shared" virtual="true">
            <Dimensions x="900" y="200" />

            <Controls>
                <Control name="$(parent)Rewards">
                    <Anchor point="TOPRIGHT" offsetX="5" offsetY="40" />
                </Control>

                <Label name="$(parent)Title" modifyTextType="UPPERCASE" horizontalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <Anchor point="LEFT" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Rewards" relativePoint="LEFT" constrains="X" />
                </Label>
            </Controls>
        </Control>

        <Control name="ZO_ReturningPlayerRewardsDailyRewardInfoContainer_Shared" inherits="ZO_ReturningPlayerRewardsRewardInfoContainer_Shared" virtual="true">
            <Controls>
                <Label name="$(parent)ClaimHeader" horizontalAlignment="CENTER" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Rewards" relativePoint="TOPLEFT" offsetY="-5" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Rewards" relativePoint="TOPRIGHT" offsetY="-5" />
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="ZO_ReturningPlayerReward_SharedTL" hidden="true" virtual="true">
            <Dimensions x="1000" y="600"/>
            <Anchor point="CENTER" />
            <Controls>
                <Control name="$(parent)Header" resizeToFitDescendents="true">
                    <Anchor point="TOPLEFT" offsetY="20" />
                    <Anchor point="TOPRIGHT" offsetY="20" />
                    <Controls>
                        <Control name="$(parent)TopDivider" inherits="ZO_PlatformStyleDynamicHorizontalDivider">
                            <Anchor point="TOPLEFT" offsetX="20" />
                            <Anchor point="TOPRIGHT" offsetX="-20" />
                        </Control>
                        <Label name="$(parent)Text" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" modifyTextType="UPPERCASE" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)TopDivider" relativePoint="BOTTOMLEFT" offsetY="5" />
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)TopDivider" relativePoint="BOTTOMRIGHT" offsetY="5" />
                        </Label>
                        <Control name="$(parent)BottomDivider" inherits="ZO_PlatformStyleDynamicHorizontalDivider">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Text" relativePoint="BOTTOMLEFT" offsetY="5" />
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Text" relativePoint="BOTTOMRIGHT" offsetY="5" />
                        </Control>
                    </Controls>
                </Control>

                <Control name="$(parent)SubHeader" resizeToFitDescendents="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetY="5" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Header" relativePoint="BOTTOMRIGHT" offsetY="5" />
                    <Controls>
                        <Label name="$(parent)Title" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <Anchor point="TOP" />
                        </Label>

                        <Label name="$(parent)TimeRemaining" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <Anchor point="TOP" relativeTo="$(parent)Title" relativePoint="BOTTOM" />
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)LoginBonus">
                    <Anchor point="TOP" relativeTo="$(parent)SubHeader" relativePoint="BOTTOM" offsetY="20" />
                </Control>

                <Control name="$(parent)RewardParticleGeneratorPosition" tier="MEDIUM">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)LoginBonus" />
                </Control>

                <Control name="$(parent)CampaignInfo">
                    <Anchor point="TOP" relativeTo="$(parent)LoginBonus" relativePoint="BOTTOM" offsetY="35" />
                </Control>

                <Label name="$(parent)BodyText" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CampaignInfo" relativePoint="BOTTOMLEFT" offsetY="15" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)CampaignInfo" relativePoint="BOTTOMRIGHT" offsetY="15" />
                </Label>

                <Control name="$(parent)Close" inherits="ZO_KeybindButton">
                    <Anchor point="BOTTOMRIGHT" offsetX="-25" offsetY="-20" />
                </Control>

                <Control name="$(parent)Primary" inherits="ZO_KeybindButton">
                    <Anchor point="RIGHT" relativeTo="$(parent)Close" relativePoint="LEFT" offsetX="-15" />
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
