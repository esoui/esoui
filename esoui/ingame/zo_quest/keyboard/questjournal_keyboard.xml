<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_QuestJournal" inherits="ZO_RightPanelFootPrint" hidden="true">
            <OnInitialized>
                ZO_QuestJournal_Keyboard_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)ModeBar" inherits="ZO_MenuBarTemplate">
                    <Anchor point="TOPRIGHT" relativeTo="ZO_SharedRightPanelBackground" offsetX="-36" offsetY="60"/>
                    <OnInitialized>
                        ZO_MenuBar_OnInitialized(self)
                        local barData =
                        {
                            buttonTemplate = "ZO_MenuBarTooltipButton",
                            normalSize = 48,
                            downSize = 52,
                            buttonPadding = 10,
                            animationDuration = 180,
                        }
                        ZO_MenuBar_SetData(self, barData)
                    </OnInitialized>
                </Control>
                <Control name="$(parent)QuestsPanel" inherits="ZO_QuestJournal_QuestsPanel_Keyboard" hidden="true"/>
                <Control name="$(parent)RumorsPanel" inherits="ZO_QuestJournal_RumorsPanel_Keyboard" hidden="true"/>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
