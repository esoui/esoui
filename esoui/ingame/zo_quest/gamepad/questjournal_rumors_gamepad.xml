<GuiXml>
    <Controls>
        <Control name="ZO_QuestJournal_RumorsPanel_Gamepad" inherits="ZO_Gamepad_ParametricList_Screen" virtual="true">
            <Controls>
                <Control name="$(parent)MiddlePane" inherits="ZO_GamepadGrid_NavQuadrant_2_3_Anchors" hidden="true">
                    <Controls>
                        <Control name="$(parent)Container" inherits="ZO_GamepadGrid_NavQuadrant_ContainerAnchors">
                            <OnInitialized>
                                self.header = self:GetNamedChild("GenericHeader")
                            </OnInitialized>
                            <Controls>
                                <Control name="$(parent)GenericHeader" inherits="ZO_GamepadGenericContentHeader"/>
                                <Control name="$(parent)Content">
                                    <Anchor point="TOPLEFT" relativeTo="$(parent)GenericHeader" relativePoint="BOTTOMLEFT"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                    <Controls>
                                        <Control name="$(parent)RumorInfoContainer" inherits="ZO_ScrollContainer_Gamepad">
                                            <AnchorFill/>
                                            <Controls>
                                                <Control name="$(parent)Scroll" override="true">
                                                    <Controls>
                                                        <Control name="$(parent)Child" override="true">
                                                            <Controls>
                                                                <Label name="$(parent)BGTitle" text="SI_QUEST_JOURNAL_RUMORS_HEARSAY" font="ZoFontGamepad42" modifyTextType="UPPERCASE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                                                                    <Anchor point="TOPLEFT"/>
                                                                    <Anchor point="TOPRIGHT" relativeTo="$(grandparent)" constrains="X"/>
                                                                </Label>
                                                                <Label name="$(parent)BGText" font="ZoFontGamepadCondensed42" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                                                                    <Anchor point="TOPLEFT" relativeTo="$(parent)BGTitle" relativePoint="BOTTOMLEFT" offsetY="15"/>
                                                                    <Anchor point="TOPRIGHT" relativeTo="$(parent)BGTitle" relativePoint="BOTTOMRIGHT" offsetY="15"/>
                                                                </Label>
                                                                <Label name="$(parent)OutcomeTitle" text="SI_QUEST_JOURNAL_RUMORS_OUTCOME" font="ZoFontGamepad42" modifyTextType="UPPERCASE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" hidden="true">
                                                                    <Anchor point="TOPLEFT"/>
                                                                    <Anchor point="TOPRIGHT" relativeTo="$(grandparent)" constrains="X"/>
                                                                </Label>
                                                                <Label name="$(parent)OutcomeText" font="ZoFontGamepadCondensed42" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" hidden="true">
                                                                    <Anchor point="TOPLEFT" relativeTo="$(parent)OutcomeTitle" relativePoint="BOTTOMLEFT" offsetY="15"/>
                                                                    <Anchor point="TOPRIGHT" relativeTo="$(parent)OutcomeTitle" relativePoint="BOTTOMRIGHT" offsetY="15"/>
                                                                </Label>
                                                            </Controls>
                                                        </Control>
                                                    </Controls>
                                                </Control>
                                            </Controls>
                                        </Control>
                                    </Controls>
                                </Control>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
