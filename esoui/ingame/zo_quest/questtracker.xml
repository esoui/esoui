<GuiXml>
    <Controls>
        <Label name="ZO_TrackedHeader" inherits="ZO_HUDTracker_Base_HeaderLabel_Template" virtual="true">
            <Anchor point="TOPLEFT" offsetX="22"/>
            <OnInitialized>
                self.icon = self:GetNamedChild("Icon")
            </OnInitialized>
            <OnMouseUp>
                ZO_TrackedHeader_MouseUp(self, button, upInside)
            </OnMouseUp>
            <OnMouseEnter>
                ZO_TrackedHeader_MouseEnter(self)
            </OnMouseEnter>
            <OnMouseExit>
                ZO_TrackedHeader_MouseExit(self)
            </OnMouseExit>
            <Controls>
                <Texture name="$(parent)Icon" level="3" excludeFromResizeToFitExtents="true" hidden="true">
                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-3"/>
                </Texture>
            </Controls>
        </Label>
        <Label name="ZO_QuestCondition" mouseEnabled="true" horizontalAlignment="RIGHT" virtual="true">
            <Dimensions x="ZO_HUD_TRACKER_MAX_WIDTH"/>
        </Label>
        <Label name="ZO_QuestStepDescription" horizontalAlignment="RIGHT" virtual="true">
            <Dimensions x="ZO_HUD_TRACKER_MAX_WIDTH"/>
        </Label>
        <Control name="ZO_FocusedQuestTrackerPanel_Template" inherits="ZO_HUDTracker_Base_Template" virtual="true">
            <OnInitialized>
                ZO_FocusedQuestTracker_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container" override="true">
                    <Controls>
                        <Control name="$(parent)TimerAnchor" resizeToFitDescendents="true">
                            <Anchor point="TOPRIGHT"/>
                            <OnInitialized>
                                ZO_QuestTimer_CreateInContainer(self)
                            </OnInitialized>
                        </Control>
                        <Control name="$(parent)QuestContainer" mouseEnabled="true" resizeToFitDescendents="true">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)TimerAnchor" relativePoint="BOTTOMRIGHT"/>
                            <Controls>
                                <Control name="$(parent)Assisted" inherits="ZO_KeybindButton" excludeFromResizeToFitExtents="true">
                                    <OnInitialized>
                                        ZO_KeybindButtonTemplate_OnInitialized(self)
                                        local HIDE_UNBOUND = false
                                        self:SetKeybind("ASSIST_NEXT_TRACKED_QUEST", HIDE_UNBOUND)
                                    </OnInitialized>
                                </Control>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
