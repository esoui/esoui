<GuiXml>
    <Controls>
        <Control name="ZO_AdvZoneOverview_FactionScoreContainer_Keyboard" inherits="ZO_AdvZoneOverview_FactionScoreContainer_Shared" virtual="true">
            <Controls>
                <Label name="$(parent)Name" override="true" font="ZoFontWinH2"/>
                <Label name="$(parent)Score" override="true" font="ZoFontWinH2"/>
            </Controls>
        </Control>
        <Control name="ZO_AdvZoneOverviewEventTile_Keyboard_Control" inherits="ZO_AdvZoneOverviewEventTile_Shared_Control ZO_NoOverlayContextualActionsTile_Keyboard_Control" virtual="true">
            <OnInitialized>
                ZO_AdventureZoneEventTile_Keyboard:New(self)
            </OnInitialized>
            <Controls>
                <Backdrop name="$(parent)OverlayBorder" override="true">
                    <Edge file="EsoUI/Art/Market/Gamepad/gp_market_cel_dark_edgeFrame_8.dds" edgeFileWidth="64" edgeFileHeight="8"/>
                </Backdrop>
                <Backdrop name="$(parent)Highlight" override="true" tier="HIGH" layer="OVERLAY" level="1">
                    <AnchorFill/>
                </Backdrop>
                <Label name="$(parent)Location" override="true" font="ZoFontWinH4"/>
                <Label name="$(parent)Title" override="true" font="ZoFontWinH2"/>
                <Label name="$(parent)Status" override="true" font="ZoFontWinH4"/>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_AdvZoneOverview_Keyboard" inherits="ZO_AdvZoneOverview_Shared">
            <DimensionConstraints minX="200" minY="50"/>
            <ResizeToFitPadding width="50" height="23"/>
            <OnInitialized>
                ZO_AdventureZoneOverview_Keyboard.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Backdrop name="$(parent)BG" override="true" inherits="ZO_MinorMungeBackdrop_SemiTransparentBlack"/>
                <Label name="$(parent)Title" override="true" font="ZoFontWinH2"/>
                <Control name="$(parent)FactionScore1" override="true" inherits="ZO_AdvZoneOverview_FactionScoreContainer_Keyboard"/>
                <Control name="$(parent)FactionScore2" override="true" inherits="ZO_AdvZoneOverview_FactionScoreContainer_Keyboard"/>
                <Control name="$(parent)FactionScore3" override="true" inherits="ZO_AdvZoneOverview_FactionScoreContainer_Keyboard"/>
                <Control name="$(parent)PlayerPointsContainer" override="true">
                    <Controls>
                        <Label name="$(parent)PlayerPointsLabel" override="true" font="ZoFontWinT1"/>
                    </Controls>
                </Control>
                <Control name="$(parent)EventsContainer" override="true" resizeToFitDescendents="true">
                    <Controls>
                        <Control name="$(parent)Event1" override="true" inherits="ZO_AdvZoneOverviewEventTile_Keyboard_Control"/>
                        <Control name="$(parent)Event2" override="true" inherits="ZO_AdvZoneOverviewEventTile_Keyboard_Control"/>
                        <Control name="$(parent)Event3" override="true" inherits="ZO_AdvZoneOverviewEventTile_Keyboard_Control"/>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
