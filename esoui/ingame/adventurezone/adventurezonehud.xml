<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_AdvZoneHUD_TopLevel" hidden="true">
            <Anchor point="TOPLEFT" offsetX="15" offsetY="15"/>
            <Anchor point="BOTTOMRIGHT" offsetX="-15" offsetY="-15"/>
            <OnInitialized>
                ZO_AdventureZoneHUD.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)PlayerScoreContainer" inherits="ZO_HUDManager_Element" resizeToFitConstrains="X">
                    <Controls>
                        <Texture name="$(parent)FactionIcon">
                            <Anchor point="LEFT"/>
                        </Texture>
                        <Control name="$(parent)Score" inherits="ZO_RollingMeterLabel">
                            <Anchor point="LEFT" relativeTo="$(parent)FactionIcon" relativePoint="RIGHT" offsetX="5"/>
                        </Control>
                        <Control name="$(parent)HUDElementRef" override="true">
                            <DimensionConstraints minX="100"/>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
