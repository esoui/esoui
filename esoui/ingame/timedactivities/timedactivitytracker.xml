<GuiXml>
    <Controls>
        <Control name="ZO_TimedActivityTracker_Template" inherits="ZO_HUDTracker_Base_Template" virtual="true">
            <OnInitialized>
                ZO_TimedActivityTracker.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container" override="true">
                    <Controls>
                        <Label name="$(parent)Header" override="true" color="INTERFACE_COLOR_TYPE_CON_COLORS:CON_APPROPRIATE">
                            <Controls>
                                <Texture name="$(parent)Icon" textureFile="EsoUI/Art/LFG/Gamepad/LFG_menuIcon_PromotionalEvents.dds" excludeFromResizeToFitExtents="true">
                                    <Dimensions x="32" y="32"/>
                                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-5"/>
                                </Texture>
                                <Control name="$(parent)Assisted" inherits="ZO_KeybindButton" excludeFromResizeToFitExtents="true">
                                    <Anchor point="RIGHT" relativeTo="$(parent)Icon" relativePoint="LEFT" offsetX="-5"/>
                                    <OnInitialized>
                                        ZO_KeybindButtonTemplate_OnInitialized(self)
                                    </OnInitialized>
                                </Control>
                            </Controls>
                        </Label>
                        <StatusBar name="$(parent)ProgressBar" inherits="ZO_ProgressBarWithGloss_Template_Base"/>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
