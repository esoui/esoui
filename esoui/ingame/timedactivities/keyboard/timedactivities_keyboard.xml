<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_RerollTimedActivityDialog_Keyboard" inherits="ZO_CustomDialogBase">
            <OnInitialized>
                ZO_RerollTimedActivityDialog_Keyboard_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Label name="$(parent)Text" inherits="ZO_DialogContentAnchors" font="ZoFontGameMedium" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"/>
                <Label name="$(parent)Balance" inherits="ZO_CurrencyTemplate">
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Text" relativePoint="BOTTOMRIGHT" offsetY="20"/>
                </Label>
                <Label name="$(parent)BalanceHeader" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGameBold" text="SI_TAMRIEL_TOMES_REROLL_CHALLENGE_DIALOG_BALANCE">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Text" relativePoint="BOTTOMLEFT" offsetY="20"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Balance" relativePoint="TOPLEFT" offsetX="-10"/>
                </Label>
                <Label name="$(parent)Cost" inherits="ZO_CurrencyTemplate">
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Balance" relativePoint="BOTTOMRIGHT" offsetY="5"/>
                </Label>
                <Label name="$(parent)CostHeader" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGameBold" text="SI_TAMRIEL_TOMES_REROLL_CHALLENGE_DIALOG_COST">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)BalanceHeader" relativePoint="BOTTOMLEFT" offsetY="20"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Cost" relativePoint="TOPLEFT" offsetX="-10"/>
                </Label>
                <Control name="$(parent)Cancel" inherits="ZO_CustomDialogButton"/>
                <Control name="$(parent)Confirm" inherits="ZO_CustomDialogButton"/>
            </Controls>
        </TopLevelControl>
        <Control name="ZO_TimedActivityTile_Keyboard_Control" inherits="ZO_ContextualActionsTile_Control ZO_FrameGlowHighlightContextualActionsTile_Keyboard_Control" virtual="true">
            <Dimensions x="ZO_TAMRIEL_TOMES_CHALLENGE_TILE_WIDTH_KEYBOARD" y="ZO_TAMRIEL_TOMES_CHALLENGE_TILE_HEIGHT_KEYBOARD"/>
            <OnInitialized>
                ZO_TimedActivityTile_Keyboard:New(self)
            </OnInitialized>
            <Controls>
                <Texture name="$(parent)Icon" override="true" hidden="true"/>
                <Label name="$(parent)Title" override="true" font="ZoFontWinH3" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" maxLineCount="1" wrapMode="ELLIPSIS" inherits="ZO_TooltipIfTruncatedLabel ZO_PropagateMouseOverBehavior ZO_PropagateMouseButtonBehavior">
                    <Anchor point="TOPLEFT" offsetX="16" offsetY="12"/>
                    <Anchor point="TOPRIGHT" offsetX="-16" offsetY="12"/>
                </Label>
                <StatusBar name="$(parent)Progress" override="true" inherits="ZO_ArrowProgressBarWithBG">
                    <Anchor point="BOTTOMLEFT" offsetX="16" offsetY="-12"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="-16" offsetY="-12"/>
                </StatusBar>
                <Label name="$(parent)RewardCurrency" inherits="ZO_CurrencyTemplate" horizontalAlignment="RIGHT">
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Progress" relativePoint="TOPRIGHT" offsetY="-5"/>
                </Label>
                <Label name="$(parent)Claimed" font="ZoFontGameMedium" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_CONTRAST">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Progress" relativePoint="TOPLEFT" offsetY="-5"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)RewardCurrency" relativePoint="BOTTOMLEFT" offsetX="-5"/>
                </Label>
                <Texture name="$(parent)ClaimableHighlight" color="734100" alpha="0.5" hidden="true">
                    <AnchorFill/>
                    <FadeGradient x1="1" y1="0" size1="400" x2="-1" y2="0" size2="400"/>
                </Texture>
                <Label name="$(parent)TimeRemaining" font="ZoFontGameMedium" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Claimed" relativePoint="TOPLEFT" offsetY="-5"/>
                </Label>
            </Controls>
        </Control>
        <Button name="ZO_TimedActivitiesKeyboard_TabButton" inherits="ZO_DefaultButton" virtual="true">
            <Dimensions x="64" y="64"/>
            <Controls>
                <Texture name="$(parent)NewIndicator" hidden="true" textureFile="/esoui/art/miscellaneous/new_icon.dds" tier="HIGH">
                    <Anchor point="CENTER" relativePoint="LEFT"/>
                    <Dimensions x="32" y="32"/>
                </Texture>
            </Controls>
        </Button>
        <TopLevelControl name="ZO_TimedActivities_KeyboardTL" hidden="true">
            <Anchor point="CENTER"/>
            <Dimensions x="1610" y="800"/>
            <OnInitialized>
                ZO_TimedActivities_Keyboard.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill/>
                </Backdrop>
                <Control name="$(parent)Tabs">
                    <Anchor point="TOPLEFT" offsetX="4" offsetY="4"/>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" offsetX="120" offsetY="-6"/>
                    <Controls>
                        <Texture name="$(parent)Backdrop" color="30303040" excludeFromResizeToFitExtents="true">
                            <AnchorFill/>
                        </Texture>
                        <Button name="$(parent)WeeklyButton" inherits="ZO_TimedActivitiesKeyboard_TabButton">
                            <Anchor point="TOP" offsetY="64"/>
                            <Textures normal="EsoUI/Art/TamrielTomes/timedActivityCategory_weekly_up.dds" pressed="EsoUI/Art/TamrielTomes/timedActivityCategory_weekly_down.dds" mouseOver="EsoUI/Art/TamrielTomes/timedActivityCategory_weekly_over.dds"/>
                            <OnMouseEnter>
                                InitializeTooltip(InformationTooltip, self, LEFT, 0, 0)
                                SetTooltipText(InformationTooltip, GetString("SI_TIMEDACTIVITYTYPE", TIMED_ACTIVITY_TYPE_WEEKLY))
                            </OnMouseEnter>
                            <OnMouseExit>
                                ClearTooltip(InformationTooltip)
                            </OnMouseExit>
                        </Button>
                        <Button name="$(parent)SeasonalButton" inherits="ZO_TimedActivitiesKeyboard_TabButton">
                            <Anchor point="TOP" relativeTo="$(parent)WeeklyButton" relativePoint="BOTTOM" offsetY="18"/>
                            <Textures normal="EsoUI/Art/TamrielTomes/timedActivityCategory_seasonal_up.dds" pressed="EsoUI/Art/TamrielTomes/timedActivityCategory_seasonal_down.dds" mouseOver="EsoUI/Art/TamrielTomes/timedActivityCategory_seasonal_over.dds"/>
                            <OnMouseEnter>
                                InitializeTooltip(InformationTooltip, self, LEFT, 0, 0)
                                SetTooltipText(InformationTooltip, GetString("SI_TIMEDACTIVITYTYPE", TIMED_ACTIVITY_TYPE_SEASONAL))
                            </OnMouseEnter>
                            <OnMouseExit>
                                ClearTooltip(InformationTooltip)
                            </OnMouseExit>
                        </Button>
                        <Texture name="$(parent)Divider" color="C6C39C">
                            <Anchor point="TOP" relativeTo="$(parent)SeasonalButton" relativePoint="BOTTOM" offsetY="24"/>
                            <Dimensions x="108" y="2"/>
                        </Texture>
                        <Label name="$(parent)CurrencyBalance" inherits="ZO_CurrencyTemplate" horizontalAlignment="CENTER">
                            <Anchor point="TOP" relativeTo="$(parent)Divider" relativePoint="BOTTOM" offsetY="20"/>
                            <Dimensions x="110"/>
                        </Label>
                    </Controls>
                </Control>
                <Control name="$(parent)Content">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Tabs" relativePoint="TOPRIGHT" offsetX="9"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-10"/>
                    <Controls>
                        <Control name="$(parent)Header">
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" offsetY="50"/>
                            <Controls>
                                <Label name="$(parent)Title" font="ZoFontWinH1" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" modifyTextType="UPPERCASE">
                                    <Anchor point="LEFT" offsetX="8" offsetY="-4"/>
                                </Label>
                                <Label name="$(parent)ResetTime" font="ZoFontWinH1" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" horizontalAlignment="RIGHT">
                                    <Anchor point="RIGHT" offsetX="-8" offsetY="-4"/>
                                </Label>
                                <Control name="$(parent)Divider" inherits="ZO_PlatformStyleDynamicHorizontalDivider ZO_PlatformStyleDynamicHorizontalDivider_Keyboard_Template">
                                    <Anchor point="BOTTOMLEFT"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Control>
                            </Controls>
                        </Control>
                        <Label name="$(parent)EmptyMessage" font="ZoFontWinH4" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" hidden="true" horizontalAlignment="CENTER">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetY="60"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Header" relativePoint="BOTTOMBOTTOMRIGHT" offsetY="60"/>
                        </Label>
                        <Control name="$(parent)List" override="true" inherits="ZO_GridScrollList_Keyboard">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetY="10"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
