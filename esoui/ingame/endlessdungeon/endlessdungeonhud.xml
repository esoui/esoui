<GuiXml>
    <Animations>
        <AnimationTimeline name="ZO_EndlessDungeonHUD_AlphaAnimation">
            <Animations>
                <AlphaAnimation duration="250" startAlpha="0" endAlpha="1">
                    <EasingFunction>
                        return ZO_EaseInQuadratic(progress)
                    </EasingFunction>
                    <OnPlay>
                        animatingControl.object:OnAlphaAnimationStarted()
                    </OnPlay>
                    <OnStop>
                        animatingControl.object:OnAlphaAnimationStopped(self:GetTimeline():IsPlayingBackward())
                    </OnStop>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <TopLevelControl name="ZO_EndlessDungeonHUD_TopLevel" hidden="true">
            <Anchor point="TOPLEFT" offsetX="15" offsetY="15"/>
            <Anchor point="BOTTOMRIGHT" offsetX="-15" offsetY="-15"/>
            <OnInitialized>
                ZO_EndlessDungeonHUD.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)ScoreContainer" inherits="ZO_HUDManager_Element" resizeToFitConstrains="X">
                    <Controls>
                        <Label name="$(parent)Header" text="SI_REVIVE_COUNTER_SCORE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"/>
                        <Control name="$(parent)Score" inherits="ZO_RollingMeterLabel">
                            <Anchor point="LEFT" relativeTo="$(parent)Header" relativePoint="RIGHT"/>
                        </Control>
                        <Texture name="$(parent)ReviveIcon" textureFile="EsoUI/Art/Trials/VitalityDepletion.dds"/>
                        <Control name="$(parent)ReviveCount" inherits="ZO_RollingMeterLabel">
                            <Anchor point="LEFT" relativeTo="$(parent)ReviveIcon" relativePoint="RIGHT"/>
                        </Control>
                        <Control name="$(parent)HUDElementRef" override="true">
                            <DimensionConstraints minX="100"/>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
