<GuiXml>
    <Controls>
        <Control name="ZO_DynamicEventsTracker_Template" inherits="ZO_HUDTracker_Base_Template" hidden="false" virtual="true">
            <OnInitialized>
                ZO_DynamicEventsTracker.OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container" override="true">
                    <Controls>
                        <StatusBar name="$(parent)ProgressBar" inherits="ZO_ProgressBarWithGloss_Template_Base">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)SubLabel" relativePoint="BOTTOMRIGHT"/>
                        </StatusBar>
                        <Label name="$(parent)TimerText" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"/>
                        <Label name="$(parent)TimerLabel" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"/>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
