<GuiXml>
    <Animations>
        <AnimationTimeline name="AlertFadeGamepad">
            <Animations>
                <AlphaAnimation duration="700" startAlpha="0" endAlpha="1">
                    <EasingFunction>
                        return ZO_EaseOutQuadratic(progress)
                    </EasingFunction>
                </AlphaAnimation>
                <AlphaAnimation duration="300" startAlpha="1" endAlpha="0"/>
            </Animations>
        </AnimationTimeline>
        <AnimationTimeline name="AlertTranslateGamepad">
            <Animations>
                <TranslateAnimation duration="0" deltaX="0" deltaY="0" anchorIndex="0">
                    <EasingFunction>
                        return ZO_EaseOutQuadratic(progress)
                    </EasingFunction>
                </TranslateAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <Label name="ZO_AlertLineGamepad" horizontalAlignment="RIGHT" font="ZoFontGamepad34" modifyTextType="UPPERCASE" virtual="true">
            <DimensionConstraints maxX="750"/>
            <Anchor point="TOPRIGHT"/>
        </Label>
        <TopLevelControl name="ZO_AlertTextNotificationGamepad" inherits="ZO_HUDManager_Element" tier="HIGH" level="ZO_HIGH_TIER_ALERT_TEXT">
            <Anchor point="TOPRIGHT" relativeTo="GuiRoot" offsetX="-15" offsetY="4"/>
            <OnInitialized>
                ZO_AlertTextGamepad_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)HUDElementRef" override="true">
                    <Anchor point="TOPRIGHT"/>
                    <Dimensions x="550" y="115"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
