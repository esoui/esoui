<GuiXml>
    <Animations>
        <AnimationTimeline name="AlertFade">
            <Animations>
                <AlphaAnimation duration="200" startAlpha="0" endAlpha="1"/>
                <AlphaAnimation duration="200" startAlpha="1" endAlpha="0"/>
            </Animations>
        </AnimationTimeline>
        <AnimationTimeline name="AlertTranslate">
            <Animations>
                <TranslateAnimation duration="0" deltaX="0" deltaY="0" anchorIndex="0"/>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <Label name="ZO_AlertLine" font="ZoFontAlert" horizontalAlignment="RIGHT" virtual="true">
            <DimensionConstraints maxX="600"/>
            <Anchor point="TOPRIGHT"/>
        </Label>
        <TopLevelControl name="ZO_AlertTextNotification" inherits="ZO_HUDManager_Element" tier="HIGH" level="ZO_HIGH_TIER_ALERT_TEXT">
            <Anchor point="TOPRIGHT" relativeTo="GuiRoot"/>
            <OnInitialized>
                ZO_AlertTextKeyboard_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)HUDElementRef" override="true">
                    <Anchor point="TOPRIGHT"/>
                    <Dimensions x="550" y="100"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
