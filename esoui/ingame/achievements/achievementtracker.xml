<GuiXml>
    <Controls>
        <Label name="ZO_AchievementTracker_Criteria" inherits="ZO_HUDTracker_Base_SubLabel_Template" virtual="true"/>
        <Control name="ZO_AchievementTracker_Template" inherits="ZO_HUDTracker_Base_Template" virtual="true">
            <OnInitialized>
                ZO_AchievementTracker.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Container" override="true">
                    <Controls>
                        <Label name="$(parent)Header" override="true">
                            <Controls>
                                <Texture name="$(parent)Icon" textureFile="EsoUI/Art/Achievements/achievements_icon_64.dds" excludeFromResizeToFitExtents="true">
                                    <Dimensions x="32" y="32"/>
                                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-5"/>
                                </Texture>
                                <Control name="$(parent)Assisted" inherits="ZO_KeybindButton" excludeFromResizeToFitExtents="true">
                                    <Anchor point="RIGHT" relativeTo="$(parent)Icon" relativePoint="LEFT" offsetX="-5"/>
                                    <OnInitialized>
                                        ZO_KeybindButtonTemplate_OnInitialized(self)
                                    </OnInitialized>
                                </Control>
                            </Controls>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
