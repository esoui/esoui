<GuiXml>
    <Controls>
        <Control name="ZO_Leaderboards_Gamepad_DropdownMenuEntry" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true">
            <Controls>
                <Texture name="$(parent)Icon" inherits="ZO_GamepadMenuEntryIconTemplate">
                    <Anchor point="CENTER" relativeTo="$(parent)Dropdown" relativePoint="LEFT" offsetX="ZO_GAMEPAD_DEFAULT_LIST_ENTRY_ICON_X_OFFSET"/>
                </Texture>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_Leaderboards_Gamepad" inherits="ZO_Gamepad_ParametricList_Screen">
            <OnInitialized>
                ZO_Leaderboards_Gamepad_OnInitialized(self)
            </OnInitialized>
        </TopLevelControl>
    </Controls>
</GuiXml>
