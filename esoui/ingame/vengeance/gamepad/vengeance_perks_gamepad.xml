<GuiXml>
    <Controls>
        <Control name="ZO_GamepadPerkSubMenuEntryWithStatusTemplate" inherits="ZO_GamepadSubMenuEntryWithStatusTemplate" virtual="true">
            <OnInitialized name="PerkEntry">
                ZO_Vengeance_Perks_Gamepad.OnMenuEntryInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)FramedIcon" inherits="ZO_VengeancePerk_FramedIcon" hidden="true" scale="0.75">
                    <Anchor point="CENTER" relativeTo="$(parent)Label" relativePoint="LEFT" offsetX="ZO_GAMEPAD_DEFAULT_LIST_ENTRY_ICON_X_OFFSET"/>
                </Control>
            </Controls>
        </Control>
        <TopLevelControl name="ZO_Vengeance_Perks_Gamepad_TopLevel" inherits="ZO_Gamepad_ParametricList_Screen">
            <OnInitialized>
                ZO_Vengeance_Perks_Gamepad.OnControlInitialized(self)
            </OnInitialized>
        </TopLevelControl>
    </Controls>
</GuiXml>
