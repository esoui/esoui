<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_ForceConsoleWarning_TopLevel" hidden="true">
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-25" />

            <OnInitialized>
                ZO_ForceConsoleWarning.OnControlInitialized(self)
            </OnInitialized>

            <Controls>
                <Label name="$(parent)ForceConsoleText" font="ZoFontGamepadBold18" text="SI_GAMEPAD_HUD_WARNING_FORCE_CONSOLE_FLOW_ENABLED" color="INTERFACE_COLOR_TYPE_GENERAL:INTERFACE_GENERAL_COLOR_ERROR">
                    <Anchor point="CENTER" />
                </Label>
            </Controls>
        </TopLevelControl>

        <TopLevelControl name="ZO_AddOnMemoryDisplay_TopLevel" hidden="true">
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-25" />
            
            <OnInitialized>
                ZO_AddOnMemoryDisplay.OnControlInitialized(self)
            </OnInitialized>

            <Controls>
                <Label name="$(parent)Memory" font="ZoFontGamepadBold18">
                    <Anchor point="CENTER" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>