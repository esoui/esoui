<GuiXml>
    <Controls>
        <TopLevelControl name="ZO_HUDTrackers" inherits="ZO_HUDManager_Element">
            <Anchor point="TOPRIGHT" offsetX="-15" offsetY="90"/>
            <Dimensions x="ZO_HUD_TRACKER_MANAGER_WIDTH" y="ZO_HUD_TRACKER_MANAGER_HEIGHT"/>
            <OnInitialized>
                ZO_HUDTracker_Manager.OnControlInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)ScrollContainer" inherits="ZO_ScrollContainer">
                    <Anchor point="TOPLEFT"/>
                    <Dimensions x="100%"/>
                    <OnInitialized>
                        ZO_Scroll_Initialize(self)
                        ZO_ScrollList_SetScrollbarEthereal(self, true)
                    </OnInitialized>
                    <Controls>
                        <Control name="$(parent)ScrollChild" override="true" resizeToFitConstrains="Y">
                            <Dimensions x="100%"/>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
