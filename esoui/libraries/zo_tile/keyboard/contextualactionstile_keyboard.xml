<GuiXml>
    <Animations>
        <AnimationTimeline name="ZO_ContextualActionsTile_Keyboard_HighlightAnimation">
            <Animations>
                <AlphaAnimation duration="255" startAlpha="0" endAlpha=".7">
                    <EasingFunction>
                        return ZO_EaseOutQuadratic(progress)
                    </EasingFunction>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <Control name="ZO_ContextualActionsTile_Base_Keyboard_Control" inherits="ZO_Tile_Keyboard_Control" mouseEnabled="true" virtual="true">
            <Controls>
                <Label name="$(parent)Title" override="true" font="ZoFontWinH2"/>
            </Controls>
        </Control>
        <Control name="ZO_ContextualActionsTile_Overlay_Keyboard_Control" virtual="true">
            <Controls>
                <Backdrop name="$(parent)OverlayBorder" override="true">
                    <Edge file="EsoUI/Art/Miscellaneous/inset_edgeFile_8.dds" edgeFileWidth="128" edgeFileHeight="16"/>
                </Backdrop>
            </Controls>
        </Control>
        <Control name="ZO_ContextualActionsTile_Keyboard_Control" inherits="ZO_ContextualActionsTile_Base_Keyboard_Control ZO_ContextualActionsTile_Overlay_Keyboard_Control" virtual="true">
            <Controls>
                <Texture name="$(parent)Highlight" textureFile="EsoUI/Art/Market/market_slotBGandHighlight.dds" alpha="0" layer="BACKGROUND" level="1">
                    <AnchorFill/>
                    <TextureCoords left="0.2880859375" right="0.576171875" top="0" bottom="0.302734375"/>
                </Texture>
            </Controls>
        </Control>
        <Control name="ZO_FrameGlowHighlightContextualActionsTile_Keyboard_Control" inherits="ZO_ContextualActionsTile_Base_Keyboard_Control ZO_ContextualActionsTile_Overlay_Keyboard_Control" virtual="true">
            <Controls>
                <Backdrop name="$(parent)Highlight" inherits="ZO_HighlightGlowFrameBackdrop">
                    <AnchorFill/>
                </Backdrop>
            </Controls>
        </Control>
        <Control name="ZO_NoOverlayContextualActionsTile_Keyboard_Control" inherits="ZO_ContextualActionsTile_Base_Keyboard_Control" virtual="true">
            <Controls>
                <Backdrop name="$(parent)Highlight" inherits="ZO_HighlightFrameBackdrop" alpha="0" layer="BACKGROUND" level="1">
                    <Anchor point="TOPLEFT" offsetX="4" offsetY="4"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-4"/>
                </Backdrop>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
