<GuiXml>
    <Controls>
        <Control name="ZO_PageNavigationIndicator" mouseEnabled="true" resizeToFitDescendents="true" virtual="true">
            <Dimensions x="46" y="40"/>
            <OnMouseUp>
                ZO_PageNavigationIndicator.OnMouseUp(self, upInside)
            </OnMouseUp>
            <Controls>
                <Texture name="$(parent)Icon" layer="2" hidden="true">
                    <Anchor point="CENTER"/>
                    <Dimensions x="32" y="32"/>
                </Texture>
                <Label name="$(parent)Number" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" horizontalAlignment="CENTER">
                    <Anchor point="CENTER"/>
                </Label>
            </Controls>
        </Control>
        <Control name="ZO_PageNavigation" resizeToFitDescendents="true" virtual="true">
            <!-- Child controls should add a "$(parent)PreviousPage" and a "$(parent)NextPage" control-->
        </Control>
        <Control name="ZO_PageNavigation_Keyboard" inherits="ZO_PageNavigation" virtual="true" resizeToFitDescendents="true">
            <Controls>
                <Button name="$(parent)PreviousPage" mouseOverBlendMode="ADD" excludeFromResizeToFitExtents="true">
                    <Dimensions x="64" y="64"/>
                    <Anchor point="RIGHT" relativePoint="LEFT"/>
                    <Textures normal="EsoUI/Art/Buttons/large_leftArrow_up.dds" pressed="EsoUI/Art/Buttons/large_leftArrow_down.dds" mouseOver="EsoUI/Art/Buttons/large_leftArrow_over.dds" disabled="EsoUI/Art/Buttons/large_leftArrow_disabled.dds"/>
                    <OnMouseEnter>
                        ZO_PageNavigation.PreviousPage_OnMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_PageNavigation.PreviousPage_OnMouseExit(self)
                    </OnMouseExit>
                    <OnClicked>
                        ZO_PageNavigation.PreviousPage_OnMouseClicked(self)
                    </OnClicked>
                </Button>
                <Button name="$(parent)NextPage" mouseOverBlendMode="ADD" excludeFromResizeToFitExtents="true">
                    <Dimensions x="64" y="64"/>
                    <Anchor point="LEFT" relativePoint="RIGHT"/>
                    <Textures normal="EsoUI/Art/Buttons/large_rightArrow_up.dds" pressed="EsoUI/Art/Buttons/large_rightArrow_down.dds" mouseOver="EsoUI/Art/Buttons/large_rightArrow_over.dds" disabled="EsoUI/Art/Buttons/large_rightArrow_disabled.dds"/>
                    <OnMouseEnter>
                        ZO_PageNavigation.NextPage_OnMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_PageNavigation.NextPage_OnMouseExit(self)
                    </OnMouseExit>
                    <OnClicked>
                        ZO_PageNavigation.NextPage_OnMouseClicked(self)
                    </OnClicked>
                </Button>
            </Controls>
        </Control>
        <Control name="ZO_PageNavigation_Gamepad" inherits="ZO_PageNavigation" virtual="true" resizeToFitDescendents="true">
            <Controls>
                <Label name="$(parent)PreviousPage" inherits="ZO_ClickableKeybindLabel_Gamepad" excludeFromResizeToFitExtents="true">
                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-20"/>
                    <OnInitialized name="ZO_PageNavigation">
                        ZO_PageNavigation.InitializePreviousPageKeybindControl(self)
                    </OnInitialized>
                </Label>
                <Label name="$(parent)NextPage" inherits="ZO_ClickableKeybindLabel_Gamepad" excludeFromResizeToFitExtents="true">
                    <Anchor point="LEFT" relativePoint="RIGHT" offsetX="20"/>
                    <OnInitialized name="ZO_PageNavigation">
                        ZO_PageNavigation.InitializeNextPageKeybindControl(self)
                    </OnInitialized>
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
